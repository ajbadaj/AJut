<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:AJut.UX.Controls"
                    xmlns:ajut_conv="using:AJut.UX.Converters">

    <x:String x:Key="AJut_Symbol_ExitFullScreenSymbol">&#xE73F;</x:String>
    <x:String x:Key="AJut_Symbol_FullScreenSymbol"    >&#xE740;</x:String>

    <!-- Literal defaults so the chrome reads sanely with no theme loaded. AJut.UX_Overrides.xaml layers the palette
         brushes on top when the AJut theme is in. The chrome has no visual states: LastState is the state machine,
         and the code behind pushes the brushes into the parts below as it changes. -->
    <Style TargetType="local:ThemedWindowRootControl">
        <Setter Property="ActiveTitleBarBackground" Value="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}"/>
        <Setter Property="InactiveTitlebarBackground" Value="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}"/>
        <Setter Property="CloseHoverBorderBrush" Value="#892630"/>
        <Setter Property="CaptionButtonHoverBackground" Value="#20808080"/>
        <Setter Property="CaptionButtonPressedBackground" Value="#40808080"/>
        <Setter Property="CloseButtonHoverBackground" Value="#E81123"/>
        <Setter Property="CloseButtonPressedBackground" Value="#F1707A"/>
        <Setter Property="TitleBarHeight" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ThemedWindowRootControl">
                    <!-- The highlights sit beside the window root, not inside it, so they measure from the window's
                         own edge the way the system's caption buttons do, border or no border. -->
                    <Grid>
                    <Border x:Name="PART_WindowRoot"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid UseLayoutRounding="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title bar background: sits under the custom title bar content and under the system's
                                 caption buttons, which are drawn with transparent backgrounds so this shows through. -->
                            <Border x:Name="PART_TitleBarBackground" Height="{TemplateBinding TitleBarHeight}" VerticalAlignment="Top"
                                    CornerRadius="{Binding ElementName=PART_WindowRoot, Path=CornerRadius, Converter={ajut_conv:CornerRadiusSideExtractionConverter Side=Top}}"/>

                            <!-- Client Area -->
                            <ContentControl x:Name="PART_ClientContainer" Grid.Row="1" Content="{TemplateBinding WindowContents}"
                                            Margin="0" Padding="0" BorderThickness="0"
                                            CornerRadius="{Binding ElementName=PART_WindowRoot, Path=CornerRadius, Converter={ajut_conv:CornerRadiusSideExtractionConverter Side=Bottom}}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                            <!-- Titlebar Area -->
                            <ContentControl x:Name="PART_CustomTitleBarContent" Content="{TemplateBinding CustomTilteBar}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Height="{TemplateBinding TitleBarHeight}"/>

                            <Border x:Name="PART_TitleBarBorder" BorderBrush="{Binding ElementName=PART_WindowRoot, Path=Background}"
                                    Grid.RowSpan="2" BorderThickness="1"
                                    CornerRadius="{Binding ElementName=PART_WindowRoot, Path=CornerRadius, Converter={ajut_conv:CornerRadiusSideExtractionConverter Side=Top}}"/>

                            <local:TitleBarCaptionButton x:Name="PART_EnterFullscreenButton"
                                                         Content="{StaticResource AJut_Symbol_FullScreenSymbol}"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Top"
                                                         Margin="0,0,138,0"/>

                            <local:TitleBarCaptionButton x:Name="PART_ExitFullscreenButton"
                                                         Content="{StaticResource AJut_Symbol_ExitFullScreenSymbol}"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Top"
                                                         Margin="0,-1,-1,0"/>
                        </Grid>
                    </Border>

                    <!-- Highlights drawn under the system's minimize, maximize and close buttons. The system draws
                         the glyphs; these carry the hover and pressed backgrounds, sized to the caption buttons by
                         the code behind. They paint over the border where a button sits, only while it is hovered
                         or pressed, which is what the system's own backgrounds did all the time. -->
                    <Border x:Name="PART_MinimizeButtonHighlight" HorizontalAlignment="Right" VerticalAlignment="Top" Width="46" Height="32" Margin="0,0,92,0" IsHitTestVisible="False"/>
                    <Border x:Name="PART_MaximizeButtonHighlight" HorizontalAlignment="Right" VerticalAlignment="Top" Width="46" Height="32" Margin="0,0,46,0" IsHitTestVisible="False"/>
                    <Border x:Name="PART_CloseButtonHighlight" HorizontalAlignment="Right" VerticalAlignment="Top" Width="46" Height="32" IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
