<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:AJut.UX.Controls">

    <!-- ===========[ DockLeafLayout: Default Style ]========================= -->
    <!-- 3-row leaf layout used by DockZone for Single and Tabbed orientations.
         Visual properties live in the Style Setters below (override per-theme without
         redefining the Template).  TemplateBinding handles most brush/radius props;
         IsTabbed-dependent BorderThickness suppression is handled in code.

         Tab overlap: PART_TabStripWrapper sits in row 2, pulled up 2px so it starts above
         the content panel's 1px bottom border.  The selected DockTabItem fills from the
         strip's top, covering that border, giving the appearance the tab connects to the
         content panel.  An unselected DockTabItem starts 2px down, just under the border,
         which serves as its top edge.  The strip's scroll viewer clips the tabs to it, so
         the overlap has to come from the strip; and it is a whole pixel past the border
         rather than exactly on it, so at a display scale where 1px is not a whole number
         of screen pixels the selected tab still covers the whole border. -->

    <Style TargetType="local:DockLeafLayout">
        <Setter Property="HorizontalAlignment"  Value="Stretch"/>
        <Setter Property="VerticalAlignment"    Value="Stretch"/>
        <Setter Property="IsTabStop"            Value="False"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>

        <!-- Default colors - override in a theme Style (no template redefinition needed). The
             header sits a level darker than the panel, with the unselected tabs. -->
        <Setter Property="Foreground">
            <Setter.Value>
                <SolidColorBrush Color="#FFF0F0F0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderBackground">
            <Setter.Value>
                <SolidColorBrush Color="#FF1E1E1E"/>
            </Setter.Value>
        </Setter>
        <!-- The panel being typed into: its header turns blue, with white text -->
        <Setter Property="HeaderFocusedBackground">
            <Setter.Value>
                <SolidColorBrush Color="#FF264F78"/>
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderFocusedForeground">
            <Setter.Value>
                <SolidColorBrush Color="#FFFFFFFF"/>
            </Setter.Value>
        </Setter>
        <Setter Property="PanelBackground">
            <Setter.Value>
                <SolidColorBrush Color="#FF2B2B2B"/>
            </Setter.Value>
        </Setter>
        <Setter Property="PanelBorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#FF4A4A4A"/>
            </Setter.Value>
        </Setter>
        <Setter Property="PanelBorderThickness" Value="1"/>
        <Setter Property="PanelCornerRadius"    Value="0"/>
        <Setter Property="TabStripBackground">
            <Setter.Value>
                <SolidColorBrush Color="Transparent"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DockLeafLayout">
                    <Grid UseLayoutRounding="True">
                        <!-- The header's background and text color come only from these states (see
                             ApplyPanelFocusState): PanelFocused while keyboard focus is within the panel
                             and its window is active, which the hosting DockZone sets as IsPanelFocused -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PanelFocusStates">
                                <VisualState x:Name="PanelUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="PART_HeaderBar.Background" Value="{Binding Path=HeaderBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Setter Target="PART_HeaderPresenter.Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PanelFocused">
                                    <VisualState.Setters>
                                        <Setter Target="PART_HeaderBar.Background" Value="{Binding Path=HeaderFocusedBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Setter Target="PART_HeaderPresenter.Foreground" Value="{Binding Path=HeaderFocusedForeground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <!-- Row 0: header bar (panel title + optional close button) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: content panel -->
                            <RowDefinition Height="*"/>
                            <!-- Row 2: tab strip (Auto height; collapsed when not tabbed) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header bar -->
                        <Border x:Name="PART_HeaderBar"
                                Grid.Row="0"
                                BorderBrush="{TemplateBinding PanelBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,-2"
                                UseLayoutRounding="True">
                            <ContentPresenter x:Name="PART_HeaderPresenter"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"/>
                        </Border>

                        <!-- Row 1: Content panel.
                             Background / BorderBrush / BorderThickness / CornerRadius /
                             Padding all pushed from code.  Bottom border is suppressed
                             when IsTabbed=true so the tab strip's top border provides
                             the sole visual boundary at that edge. -->
                        <Border x:Name="PART_ContentBorder"
                                Grid.Row="1"
                                Padding="2"
                                BorderThickness="{TemplateBinding PanelBorderThickness}"
                                CornerRadius="0"
                                Background="{TemplateBinding PanelBackground}"
                                BorderBrush="{TemplateBinding PanelBorderBrush}"
                                UseLayoutRounding="True">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>

                        <!-- Row 2: Tab strip.
                             Margin top -2: pulls the strip up past the content panel's
                             bottom border (see the tab overlap note above).  The outer Grid
                             does not clip, so the -2px offset renders correctly.
                             Visibility is toggled by ApplyTabbedState() in code. -->
                        <Border x:Name="PART_TabStripWrapper"
                                Grid.Row="2"
                                Margin="5,-2,5,5"
                                BorderThickness="0,0,0,0"
                                Padding="2,0,2,2"
                                Background="{TemplateBinding TabStripBackground}"
                                Visibility="Collapsed"
                                Height="28"
                                UseLayoutRounding="True">
                            <ContentPresenter x:Name="PART_TabNavPresenter"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
