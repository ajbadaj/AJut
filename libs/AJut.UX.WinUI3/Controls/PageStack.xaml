<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:AJut.UX.Controls">

    <!-- ===[ PageStack page button ]=== -->
    <!-- A page button keeps the fill, glyph and outline its PageStack gives it in every state and shows its state by opacity
         alone, as BumpStack's bump buttons do: brighter under the pointer, dimmed when there is no page that way. -->
    <Style x:Key="AJut_Style_PageStackPageButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Opacity="0.8">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.8"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="1.0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="1.0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===[ PageStackDot ]=== -->
    <!-- One dot in the strip. The transparent border around the dot is its hit area. The pointer states fade the whole dot,
         and the kind states pick its fill and size: the current page's dot takes CurrentDotBrush, and an edge dot (more
         pages past the window) draws smaller and faded, growing to full size, still faded, under the pointer. The fill is
         set by the kind states alone, never a TemplateBinding, since a TemplateBinding on a property a state sets
         overwrites the state. -->
    <Style TargetType="local:PageStackDot">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PageStackDot">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" Opacity="0.85">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.85"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="1.0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="1.0"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- The size and fade are storyboards rather than setters so the transition below eases them: a
                                 dot grows or shrinks as it slides into or out of the window, or as the pointer comes over
                                 an edge dot. The fill is a setter, since a brush can't ease. -->
                            <VisualStateGroup x:Name="KindStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Page">
                                    <VisualState.Setters>
                                        <Setter Target="DotShape.Fill" Value="{Binding Path=DotBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="DotShape" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Current">
                                    <VisualState.Setters>
                                        <Setter Target="DotShape.Fill" Value="{Binding Path=CurrentDotBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="DotShape" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Edge">
                                    <VisualState.Setters>
                                        <Setter Target="DotShape.Fill" Value="{Binding Path=DotBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="0.6" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="0.6" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="DotShape" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="EdgePointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="DotShape.Fill" Value="{Binding Path=DotBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="DotShape" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Ellipse x:Name="DotShape"
                                 Width="{TemplateBinding DotSize}"
                                 Height="{TemplateBinding DotSize}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="DotScale"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===[ PageStack ]=== -->
    <!-- One page at a time, with a page button at each end and an optional dot strip. The page hosts, their placement and
         fading, the page buttons' visibility and enabling, and the dots are driven from code-behind; the template lays out
         the page area, the two overlaid page buttons and the dot strip, and the orientation states turn them. The page
         buttons sit over the neighbor pages' peeks, so they are outlined to stand apart from what is behind them. -->
    <Style TargetType="local:PageStack">
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="ButtonBackground" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}"/>
        <Setter Property="ButtonForeground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="ButtonBorder" Value="{ThemeResource ButtonBorderBrush}"/>
        <Setter Property="DotBrush" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="CurrentDotBrush" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PageStack">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="OrientationStates">
                                <VisualState x:Name="Horizontal">
                                    <VisualState.Setters>
                                        <Setter Target="PART_BackButton.HorizontalAlignment" Value="Left"/>
                                        <Setter Target="PART_BackButton.VerticalAlignment" Value="Stretch"/>
                                        <Setter Target="PART_ForwardButton.HorizontalAlignment" Value="Right"/>
                                        <Setter Target="PART_ForwardButton.VerticalAlignment" Value="Stretch"/>
                                        <Setter Target="BackGlyph.Glyph" Value="&#xE76B;"/>
                                        <Setter Target="ForwardGlyph.Glyph" Value="&#xE76C;"/>
                                        <Setter Target="PART_DotsHost.(Grid.Row)" Value="1"/>
                                        <Setter Target="PART_DotsHost.(Grid.Column)" Value="0"/>
                                        <Setter Target="PART_DotsHost.HorizontalAlignment" Value="Center"/>
                                        <Setter Target="PART_DotsHost.VerticalAlignment" Value="Top"/>
                                        <Setter Target="PART_DotsPanel.Orientation" Value="Horizontal"/>
                                        <Setter Target="DotStripLayout.Orientation" Value="Horizontal"/>
                                        <Setter Target="PART_PageCountText.Margin" Value="8,0,0,0"/>
                                        <Setter Target="PART_PageCountText.HorizontalAlignment" Value="Left"/>
                                        <Setter Target="PART_PageCountText.VerticalAlignment" Value="Center"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Vertical">
                                    <VisualState.Setters>
                                        <Setter Target="PART_BackButton.HorizontalAlignment" Value="Stretch"/>
                                        <Setter Target="PART_BackButton.VerticalAlignment" Value="Top"/>
                                        <Setter Target="PART_ForwardButton.HorizontalAlignment" Value="Stretch"/>
                                        <Setter Target="PART_ForwardButton.VerticalAlignment" Value="Bottom"/>
                                        <Setter Target="BackGlyph.Glyph" Value="&#xE70E;"/>
                                        <Setter Target="ForwardGlyph.Glyph" Value="&#xE70D;"/>
                                        <Setter Target="PART_DotsHost.(Grid.Row)" Value="0"/>
                                        <Setter Target="PART_DotsHost.(Grid.Column)" Value="1"/>
                                        <Setter Target="PART_DotsHost.HorizontalAlignment" Value="Left"/>
                                        <Setter Target="PART_DotsHost.VerticalAlignment" Value="Center"/>
                                        <Setter Target="PART_DotsPanel.Orientation" Value="Vertical"/>
                                        <Setter Target="DotStripLayout.Orientation" Value="Vertical"/>
                                        <Setter Target="PART_PageCountText.Margin" Value="0,8,0,0"/>
                                        <Setter Target="PART_PageCountText.HorizontalAlignment" Value="Center"/>
                                        <Setter Target="PART_PageCountText.VerticalAlignment" Value="Top"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="PART_PagesClip">
                                <Grid x:Name="PART_PageViewport"/>

                                <Button x:Name="PART_BackButton"
                                        Style="{StaticResource AJut_Style_PageStackPageButton}"
                                        AutomationProperties.Name="Previous page"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{TemplateBinding ButtonBackground}"
                                        Foreground="{TemplateBinding ButtonForeground}"
                                        BorderBrush="{TemplateBinding ButtonBorder}"
                                        Padding="{TemplateBinding ButtonPadding}"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <FontIcon x:Name="BackGlyph" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76B;" FontSize="{TemplateBinding ButtonFontSize}"/>
                                </Button>
                                <Button x:Name="PART_ForwardButton"
                                        Style="{StaticResource AJut_Style_PageStackPageButton}"
                                        AutomationProperties.Name="Next page"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Background="{TemplateBinding ButtonBackground}"
                                        Foreground="{TemplateBinding ButtonForeground}"
                                        BorderBrush="{TemplateBinding ButtonBorder}"
                                        Padding="{TemplateBinding ButtonPadding}"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <FontIcon x:Name="ForwardGlyph" FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" FontSize="{TemplateBinding ButtonFontSize}"/>
                                </Button>
                            </Grid>

                            <!-- The dot strip: the dots, and the page count after them when ShowPageCount is on, below the
                                 pages or beside them when vertical. The host takes DotStripPadding. The canvas is sized to
                                 the strip's dots and clipped to them from code, and the panel of dots slides along it under
                                 a transform when the page changes, holding the dots sliding out of view and in. A canvas,
                                 since it never clips or constrains the panel by layout. -->
                            <Border x:Name="PART_DotsHost"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                <StackPanel x:Name="DotStripLayout" Orientation="Horizontal">
                                    <Canvas x:Name="PART_DotsClip">
                                        <StackPanel x:Name="PART_DotsPanel" Orientation="Horizontal">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform/>
                                            </StackPanel.RenderTransform>
                                        </StackPanel>
                                    </Canvas>
                                    <TextBlock x:Name="PART_PageCountText"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
