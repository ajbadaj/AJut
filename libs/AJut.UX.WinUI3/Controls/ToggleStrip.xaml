<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:AJut.UX.Controls">

    <!-- ===[ ToggleStrip ]=== -->
    <!-- Default style: WinUI3 system resources only, no AJut_ brush keys.
         AllControlThemeOverrides.xaml provides the AJut-branded variant.
         PART_ItemsPanel is a StackPanel; code populates it with ToggleStripButton items.
         The OrientationStates group turns the strip for its Orientation DP.
         ToggleStripButton controls own all button-level visual state - no Border.Resources
         overrides are needed here. -->
    <Style TargetType="local:ToggleStrip">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemPadding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <!-- Disabled, as WinUI's own ComboBox: its disabled fill, its border and its disabled text -->
        <Setter Property="DisabledBackground" Value="{ThemeResource ControlFillColorDisabledBrush}"/>
        <Setter Property="DisabledBorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="DisabledForeground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ToggleStrip">
                    <Border x:Name="StripBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <!-- OrientationStates: code goes to Horizontal or Vertical from the strip's
                             Orientation. Literal values only (structural, nothing themed), and each state
                             sets every property explicitly so switching back and forth always lands clean.
                             Vertical turns the BumpStack so it scrolls and bumps up and down, and moves the
                             overflow chevron to the bottom edge pointing down. PART_ItemsPanel is turned from
                             code instead: the BumpStack moves it into its own template, so it is not a safe
                             setter target from here. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="OrientationStates">
                                <VisualState x:Name="Horizontal">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ScrollHost.Orientation" Value="Horizontal"/>
                                        <Setter Target="PART_ScrollHost.ButtonPadding" Value="4,0"/>
                                        <Setter Target="PART_OverflowButton.HorizontalAlignment" Value="Right"/>
                                        <Setter Target="PART_OverflowButton.VerticalAlignment" Value="Stretch"/>
                                        <Setter Target="PART_OverflowButton.Padding" Value="6,0"/>
                                        <Setter Target="OverflowGlyph.Glyph" Value="&#xE76C;"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Vertical">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ScrollHost.Orientation" Value="Vertical"/>
                                        <Setter Target="PART_ScrollHost.ButtonPadding" Value="0,4"/>
                                        <Setter Target="PART_OverflowButton.HorizontalAlignment" Value="Stretch"/>
                                        <Setter Target="PART_OverflowButton.VerticalAlignment" Value="Bottom"/>
                                        <Setter Target="PART_OverflowButton.Padding" Value="0,6"/>
                                        <Setter Target="OverflowGlyph.Glyph" Value="&#xE70D;"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- CommonStates: code goes to Disabled while the strip's IsEnabled is false. The strip's own
                                 Disabled brushes go on the frame and on the items' text, which inherits from the BumpStack
                                 that holds them. The items keep their fills, so the selection still shows. -->
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="StripBorder.Background" Value="{Binding Path=DisabledBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Setter Target="StripBorder.BorderBrush" Value="{Binding Path=DisabledBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Setter Target="PART_ScrollHost.Foreground" Value="{Binding Path=DisabledForeground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- ButtonColorStates: the colors of the bump buttons and the overflow button, which hang on both
                                 the orientation and IsEnabled, so code picks the state from the two together. They live in a
                                 group of their own because two groups that set one property leave it to whichever state was
                                 entered last, so a strip turned while disabled would get its live colors back.
                                 InStrip (horizontal, enabled) leaves them on the strip's own colors, inside its shading.
                                 Plain (vertical, enabled) takes the plain button colors: the strip's surface shades top to
                                 bottom, so across a vertical strip's ends the buttons would show a slice of it that reads as
                                 part of neither.
                                 DisabledButtons takes the strip's Disabled brushes, with the outline on the fill as InStrip
                                 has it. -->
                            <VisualStateGroup x:Name="ButtonColorStates">
                                <VisualState x:Name="InStrip"/>
                                <VisualState x:Name="Plain">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ScrollHost.ButtonBackground" Value="{ThemeResource ButtonBackground}"/>
                                        <Setter Target="PART_ScrollHost.ButtonBorder" Value="{ThemeResource ButtonBorderBrush}"/>
                                        <Setter Target="PART_ScrollHost.ButtonForeground" Value="{ThemeResource ButtonForeground}"/>
                                        <Setter Target="PART_OverflowButton.Background" Value="{ThemeResource ButtonBackground}"/>
                                        <Setter Target="PART_OverflowButton.Foreground" Value="{ThemeResource ButtonForeground}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="DisabledButtons">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ScrollHost.ButtonBackground" Value="{Binding Path=DisabledBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Setter Target="PART_ScrollHost.ButtonBorder" Value="{Binding Path=DisabledBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Setter Target="PART_ScrollHost.ButtonForeground" Value="{Binding Path=DisabledForeground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Setter Target="PART_OverflowButton.Background" Value="{Binding Path=DisabledBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <Setter Target="PART_OverflowButton.Foreground" Value="{Binding Path=DisabledForeground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Single overlay cell: the BumpStack hosts the items and (in Scroll mode)
                             provides the bump-scroll buttons; the overflow chevron is drawn on top at
                             the trailing edge (right, or bottom when vertical) so it never consumes
                             layout length (which would otherwise feed back into the overflow calculation). -->
                        <Grid>
                            <!-- The bump buttons are part of the strip, inside its own frame, so their outline is
                                 their fill rather than a second frame -->
                            <local:BumpStack x:Name="PART_ScrollHost"
                                             ScrollingEnabled="False"
                                             ButtonBackground="{TemplateBinding Background}"
                                             ButtonForeground="{TemplateBinding Foreground}"
                                             ButtonBorder="{TemplateBinding Background}">
                                <StackPanel x:Name="PART_ItemsPanel"
                                            Orientation="Horizontal"/>
                            </local:BumpStack>

                            <!-- Overflow chevron + popup: code shows this only in OverflowPopup mode
                                 when items actually overflow, and fills the flyout's panel. -->
                            <Button x:Name="PART_OverflowButton"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Padding="6,0"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Visibility="Collapsed">
                                <FontIcon x:Name="OverflowGlyph"
                                          FontFamily="Segoe MDL2 Assets"
                                          Glyph="&#xE76C;"
                                          FontSize="12"/>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinWidth" Value="0"/>
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel x:Name="PART_OverflowPanel"
                                                    Orientation="Vertical"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
