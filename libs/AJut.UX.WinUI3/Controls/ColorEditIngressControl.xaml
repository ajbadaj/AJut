<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:AJut.UX.Controls">

    <!-- ===[ ColorEditIngressControl ]=== -->
    <!-- Shows a solid-color swatch. Tap/click opens a Flyout (built in code-behind)
         containing the native WinUI3 ColorPicker.
         White Background on the outer Border provides an opaque backdrop for
         semi-transparent colors so the alpha channel is visually apparent.
         On hover:  gloss overlay hides, edit indicator overlay appears.
         On open:   border swaps to EditingOpen state via VSM (EditingStates group). -->
    <Style TargetType="local:ColorEditIngressControl">
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorEditIngressControl">
                    <!-- PART_Root: outer border; BorderBrush controlled by EditingStates VSM. -->
                    <Border x:Name="PART_Root"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="White">
                        <Border.Resources>
                            <!-- The eyedropper button under the ColorPicker in the flyout, which is built in code and
                                 takes this style. The eyedropper, leaning 45 degrees in a 24 x 24 box, the same
                                 geometry as the WPF editor's: a solid bulb and collar, and the clear tube as an outline
                                 with a rounded tip, its inside cut out by the even odd fill (F0). -->
                            <Style x:Key="PickFromScreenButtonStyle" TargetType="Button">
                                <Setter Property="Margin" Value="0,8,0,0"/>
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Path Width="16" Height="16" Stretch="Uniform"
                                                  Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"
                                                  Data="F0 M 12.41,7.34 L 14.54,5.22 A 3,3 0 0 1 18.78,9.46 L 16.66,11.59 Z M 11,5.93 L 18.07,13 L 16.3,14.77 L 9.23,7.7 Z M 11.35,9.82 L 14.18,12.65 L 9.23,17.6 L 5.63,19.51 A 0.85,0.85 0 0 1 4.49,18.37 L 6.4,14.77 Z M 12.24,10.7 L 13.3,11.76 L 8.28,16.78 L 5.91,18.09 L 7.22,15.72 Z"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="PART_FancyCover.Visibility" Value="Visible"/>
                                        <Setter Target="PART_EditOverlay.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_FancyCover.Visibility" Value="Collapsed"/>
                                        <Setter Target="PART_EditOverlay.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="EditingStates">
                                <VisualState x:Name="EditingOpen">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Root.BorderBrush"
                                                Value="{ThemeResource AJut_ColorEditIngressControl_HighlightBorderBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="EditingClosed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Root.BorderBrush"
                                                Value="{ThemeResource AJut_ColorEditIngressControl_NormalBorderBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid>
                            <!-- PART_Swatch: Background set in code to EditColor. -->
                            <Border x:Name="PART_Swatch"/>

                            <!-- Gloss overlay: visible in Normal state, hidden on hover. -->
                            <Grid x:Name="PART_FancyCover"
                                  IsHitTestVisible="False">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#25FFFFFF" Offset="0"/>
                                        <GradientStop Color="#0CFFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#0C000000" Offset="0.5"/>
                                        <GradientStop Color="#23000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                            </Grid>

                            <!-- Edit overlay: shown on hover and while flyout is open. -->
                            <Grid x:Name="PART_EditOverlay"
                                  IsHitTestVisible="False"
                                  Visibility="Collapsed">
                                <Grid.Background>
                                    <SolidColorBrush Color="#60000000"/>
                                </Grid.Background>
                                <!-- Dog-ear triangle + pencil icon in a Viewbox so it scales
                                     proportionally with the control, capped at 20x20.
                                     Margin="2" keeps it 2px from the bottom-right corner. -->
                                <Viewbox HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         MaxWidth="24"
                                         MaxHeight="24"
                                         Margin="0"
                                         Stretch="Uniform"
                                         IsHitTestVisible="False">
                                    <Grid>
                                        <Path Data="M 0,24 L 24,24 L 24,0 Z"
                                              Fill="#33505050"/>
                                        <Path Data="M 0,24 L 24,24 Z" Stroke="#3FFF"/>
                                        <FontIcon Glyph="&#xE70F;"
                                                  FontFamily="Segoe Fluent Icons"
                                                  FontSize="14"
                                                  Foreground="White"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Bottom"
                                                  Margin="1"/>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
