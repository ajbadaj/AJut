         and buttons are see through until the bar expands, as stock, and the thumb is a step up from the common border
         so it shows on a list. -->
    <SolidColorBrush x:Key="ScrollViewerScrollBarSeparatorBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundDisabled" Color="Transparent"/>
