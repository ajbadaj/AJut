<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===[ Corner Radius ]=== -->
    <!-- Matches WPF AJut aesthetic: minimal rounding -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>

    <!-- ===[ Accent Colors ]=== -->
    <StaticResource x:Key="SystemAccentColor" ResourceKey="AJut_Color_PrimaryHighlight" />
    <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="AJut_Color_PrimaryHighlightDark" />
    <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="AJut_Color_PrimaryHighlightBright" />
    <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="AJut_Color_PrimaryHighlightDesat" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource AJut_Color_PrimaryHighlight}" />

    <StaticResource x:Key="SystemAccentColor2" ResourceKey="AJut_Color_SecondaryHighlight" />
    <StaticResource x:Key="SystemAccentColor2Dark1" ResourceKey="AJut_Color_SecondaryHighlightDark" />
    <StaticResource x:Key="SystemAccentColor2Light1" ResourceKey="AJut_Color_SecondaryHighlightBright" />
    <StaticResource x:Key="SystemAccentColor2Light2" ResourceKey="AJut_Color_SecondaryHighlightDesat" />

    <!-- ===[ Text Brushes ]=== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource AJut_Color_NormalText}"/>
    <SolidColorBrush x:Key="TextBoxForegroundThemeBrush" Color="{ThemeResource AJut_Color_NormalText}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource AJut_Color_InteractiveText}"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{ThemeResource AJut_Color_HighlightText}"/>
    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="{ThemeResource AJut_Color_NormalText}"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{ThemeResource AJut_Color_NormalText}"/>

    <!-- ===[ List Accent Brushes ]=== -->
    <StaticResource x:Key="SystemListAccentLowColor" ResourceKey="AJut_Color_PrimaryHighlightDesat" />
    <StaticResource x:Key="SystemListAccentMediumColor" ResourceKey="AJut_Color_PrimaryHighlight" />
    <StaticResource x:Key="SystemListAccentHighColor" ResourceKey="AJut_Color_PrimaryHighlightBright" />
    <StaticResource x:Key="SystemListLowBrush" ResourceKey="AJut_Brush_ListBackground" />
    <StaticResource x:Key="SystemListMediumBrush" ResourceKey="AJut_Brush_ListBorder" />
    <StaticResource x:Key="SystemListAccentMediumBrush" ResourceKey="AJut_Brush_ListSelection" />

    <!-- ===[ TitleBar / Chrome Colors ]=== -->
    <StaticResource x:Key="SystemChromeBlackHighBrush" ResourceKey="AJut_Brush_ChromeButtonHoverBackground" />
    <!-- Named as a color and read as a hover foreground, so it points at the hover foreground color rather than the
         hover background brush it used to name. -->
    <StaticResource x:Key="TitleBarCaptionButtonHoverForegroundColor" ResourceKey="AJut_Color_ChromeButtonHoverForeground"/>
    <StaticResource x:Key="TitleBarCaptionButtonPressedForegroundColor" ResourceKey="AJut_Color_ChromeButtonPressedForeground"/>
    <StaticResource x:Key="TitleBarCaptionButtonInactiveForegroundColor" ResourceKey="AJut_Color_ChromeButtonInactiveForeground"/>
    <StaticResource x:Key="TitleBarCaptionButtonForegroundColor" ResourceKey="AJut_Brush_TitleBarForeground"/>
    <StaticResource x:Key="TitleBarForegroundBrush" ResourceKey="AJut_Brush_TitleBarForeground"/>
    <StaticResource x:Key="TitleBarDeactivatedForegroundBrush" ResourceKey="AJut_Brush_TitleBarForegroundDesat"/>

    <!-- ===[ TabView Colors ]=== -->
    <SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{ThemeResource AJut_Color_InnerPanelBackgroundHover}"/>
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource AJut_Color_InnerPanelBackground}" />
    <StaticResource x:Key="TabViewItemHeaderDragBackground" ResourceKey="AJut_Brush_PopupBackground" />
    <StaticResource x:Key="TabViewItemHeaderBackgroundPressed" ResourceKey="AJut_Brush_PopupBackground" />
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent" />
    <!-- AJut's TabView template: the strip border, the add and scroll buttons and the tab close buttons as glyph buttons, and the tab text and icons -->
    <StaticResource x:Key="TabViewBorderBrush" ResourceKey="AJut_Brush_BorderCommon"/>
    <StaticResource x:Key="TabViewItemSeparator" ResourceKey="AJut_Brush_BorderCommon"/>
    <StaticResource x:Key="TabViewSelectedItemBorderBrush" ResourceKey="AJut_Brush_BorderCommon"/>
    <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
    <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="AJut_Brush_InteractiveText"/>
    <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="{ThemeResource AJut_Color_HighlightText}"/>
    <SolidColorBrush x:Key="TabViewItemHeaderForegroundPressed" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="AJut_Brush_NormalText"/>
    <SolidColorBrush x:Key="TabViewItemHeaderForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <StaticResource x:Key="TabViewItemIconForeground" ResourceKey="AJut_Brush_InteractiveText"/>
    <SolidColorBrush x:Key="TabViewItemIconForegroundPointerOver" Color="{ThemeResource AJut_Color_HighlightText}"/>
    <SolidColorBrush x:Key="TabViewItemIconForegroundPressed" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <StaticResource x:Key="TabViewItemIconForegroundSelected" ResourceKey="AJut_Brush_NormalText"/>
    <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent"/>
    <StaticResource x:Key="TabViewButtonForeground" ResourceKey="AJut_Brush_SymbolForeground"/>
    <SolidColorBrush x:Key="TabViewButtonBorderBrush" Color="Transparent"/>
    <StaticResource x:Key="TabViewButtonBackgroundPointerOver" ResourceKey="AJut_Brush_MouseInteractionHighlight"/>
    <StaticResource x:Key="TabViewButtonForegroundPointerOver" ResourceKey="AJut_Brush_SymbolForegroundHighlight"/>
    <SolidColorBrush x:Key="TabViewButtonBorderBrushPointerOver" Color="Transparent"/>
    <StaticResource x:Key="TabViewButtonBackgroundPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <StaticResource x:Key="TabViewButtonForegroundPressed" ResourceKey="AJut_Brush_SymbolForegroundPressed"/>
    <SolidColorBrush x:Key="TabViewButtonBorderBrushPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewButtonBackgroundDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewButtonForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <SolidColorBrush x:Key="TabViewButtonBorderBrushDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewScrollButtonBackground" Color="Transparent"/>
    <StaticResource x:Key="TabViewScrollButtonForeground" ResourceKey="AJut_Brush_SymbolForeground"/>
    <SolidColorBrush x:Key="TabViewScrollButtonBorderBrush" Color="Transparent"/>
    <StaticResource x:Key="TabViewScrollButtonBackgroundPointerOver" ResourceKey="AJut_Brush_MouseInteractionHighlight"/>
    <StaticResource x:Key="TabViewScrollButtonForegroundPointerOver" ResourceKey="AJut_Brush_SymbolForegroundHighlight"/>
    <SolidColorBrush x:Key="TabViewScrollButtonBorderBrushPointerOver" Color="Transparent"/>
    <StaticResource x:Key="TabViewScrollButtonBackgroundPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <StaticResource x:Key="TabViewScrollButtonForegroundPressed" ResourceKey="AJut_Brush_SymbolForegroundPressed"/>
    <SolidColorBrush x:Key="TabViewScrollButtonBorderBrushPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewScrollButtonBackgroundDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewScrollButtonForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <SolidColorBrush x:Key="TabViewScrollButtonBorderBrushDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewItemHeaderCloseButtonBackground" Color="Transparent"/>
    <StaticResource x:Key="TabViewItemHeaderCloseButtonForeground" ResourceKey="AJut_Brush_SymbolForeground"/>
    <SolidColorBrush x:Key="TabViewItemHeaderCloseButtonBorderBrush" Color="Transparent"/>
    <StaticResource x:Key="TabViewItemHeaderCloseButtonBackgroundPointerOver" ResourceKey="AJut_Brush_MouseInteractionHighlight"/>
    <StaticResource x:Key="TabViewItemHeaderCloseButtonForegroundPointerOver" ResourceKey="AJut_Brush_SymbolForegroundHighlight"/>
    <SolidColorBrush x:Key="TabViewItemHeaderCloseButtonBorderBrushPointerOver" Color="Transparent"/>
    <StaticResource x:Key="TabViewItemHeaderCloseButtonBackgroundPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <StaticResource x:Key="TabViewItemHeaderCloseButtonForegroundPressed" ResourceKey="AJut_Brush_SymbolForegroundPressed"/>
    <SolidColorBrush x:Key="TabViewItemHeaderCloseButtonBorderBrushPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewItemHeaderCloseButtonBorderBrushDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewItemHeaderPointerOverCloseButtonBackground" Color="Transparent"/>
    <StaticResource x:Key="TabViewItemHeaderPointerOverCloseButtonForeground" ResourceKey="AJut_Brush_SymbolForeground"/>
    <SolidColorBrush x:Key="TabViewItemHeaderPressedCloseButtonBackground" Color="Transparent"/>
    <StaticResource x:Key="TabViewItemHeaderPressedCloseButtonForeground" ResourceKey="AJut_Brush_SymbolForeground"/>
    <SolidColorBrush x:Key="TabViewItemHeaderSelectedCloseButtonBackground" Color="Transparent"/>
    <StaticResource x:Key="TabViewItemHeaderSelectedCloseButtonForeground" ResourceKey="AJut_Brush_SymbolForeground"/>
    <SolidColorBrush x:Key="TabViewItemHeaderDisabledCloseButtonBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="TabViewItemHeaderDisabledCloseButtonForeground" Color="{ThemeResource AJut_Color_UnderstatedText}"/>

    <!-- ===[ Window Caption Colors ]=== -->
    <SolidColorBrush x:Key="WindowCaptionBackground" Color="{ThemeResource AJut_Color_ChromeButtonBackground}" />
    <SolidColorBrush x:Key="WindowCaptionBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="WindowCaptionForeground" Color="{ThemeResource AJut_Color_ChromeButtonForeground}" />
    <SolidColorBrush x:Key="WindowCaptionForegroundDisabled" Color="{ThemeResource AJut_Color_ChromeButtonInactiveForeground}" />
    <SolidColorBrush x:Key="WindowCaptionButtonBackgroundPointerOver" Color="{ThemeResource AJut_Color_ChromeButtonHoverBackground}" />
    <SolidColorBrush x:Key="WindowCaptionButtonBackgroundPressed" Color="{ThemeResource AJut_Color_ChromeButtonPressedBackground}" />
    <SolidColorBrush x:Key="WindowCaptionButtonStroke" Color="{ThemeResource AJut_Color_ChromeButtonForeground}" />
    <SolidColorBrush x:Key="WindowCaptionButtonStrokePointerOver" Color="{ThemeResource AJut_Color_ChromeButtonHoverForeground}" />
    <SolidColorBrush x:Key="WindowCaptionButtonStrokePressed" Color="{ThemeResource AJut_Color_ChromeButtonPressedForeground}" />
    <SolidColorBrush x:Key="WindowCaptionButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CloseButtonBackgroundPointerOver" Color="{ThemeResource AJut_Color_ChromeCloseButtonHighlight}" />
    <SolidColorBrush x:Key="CloseButtonStrokePointerOver" Color="{ThemeResource AJut_Color_ChromeButtonHoverForeground}" />
    <SolidColorBrush x:Key="CloseButtonBackgroundPressed" Color="{ThemeResource AJut_Color_ChromeCloseButtonComplement}" />
    <SolidColorBrush x:Key="CloseButtonStrokePressed" Color="{ThemeResource AJut_Color_ChromeCloseButtonHoverForeground}" />

    <!-- ===[ ControlFill (backing TextBox, ComboBox, etc.) ]=== -->
    <StaticResource x:Key="ControlFillColorDefaultBrush" ResourceKey="AJut_Brush_ControlBackground"/>
    <StaticResource x:Key="ControlFillColorSecondaryBrush" ResourceKey="AJut_Brush_ControlBackgroundHover"/>
    <StaticResource x:Key="ControlFillColorInputActiveBrush" ResourceKey="AJut_Brush_ControlBackground"/>

    <!-- ===[ TextControl (TextBox, PasswordBox, etc.) ]=== -->
    <StaticResource x:Key="TextControlForeground" ResourceKey="AJut_Color_NormalText" />
    <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="AJut_Color_HighlightText" />
    <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="AJut_Color_InteractiveText" />
    <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="AJut_Color_UnderstatedText" />
    <StaticResource x:Key="TextControlBackground" ResourceKey="AJut_Brush_TextBoxBackground"/>
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="AJut_Brush_TextBoxBackground"/>
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="AJut_Brush_TextBoxBackground"/>
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="AJut_Brush_TextBoxBorder"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource AJut_Color_PrimaryHighlightBright}"/>
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="AJut_Brush_PrimaryHighlight"/>
    <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="AJut_Brush_UnderstatedText"/>
    <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="AJut_Brush_InteractiveTextUnfocused"/>
    <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="AJut_Brush_UnderstatedText"/>
    <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="AJut_Brush_TextBoxBackground"/>
    <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="AJut_Brush_TextBoxBorder"/>
    <SolidColorBrush x:Key="TextControlHeaderForeground" Color="{ThemeResource AJut_Color_NormalText}"/>
    <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="AJut_Brush_PrimaryHighlight"/>
    <!-- The clear button inside a text box -->
    <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent"/>
    <StaticResource x:Key="TextControlButtonBackgroundPointerOver" ResourceKey="AJut_Brush_MouseInteractionHighlight"/>
    <StaticResource x:Key="TextControlButtonBackgroundPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <StaticResource x:Key="TextControlButtonForeground" ResourceKey="AJut_Brush_SymbolForeground"/>
    <StaticResource x:Key="TextControlButtonForegroundPointerOver" ResourceKey="AJut_Brush_SymbolForegroundHighlight"/>
    <StaticResource x:Key="TextControlButtonForegroundPressed" ResourceKey="AJut_Brush_SymbolForegroundHighlight"/>
    <SolidColorBrush x:Key="TextControlButtonBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlButtonBorderBrushPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="TextControlButtonBorderBrushPressed" Color="Transparent"/>

    <!-- ===[ Button ]=== -->
    <StaticResource x:Key="ButtonForeground" ResourceKey="AJut_Brush_NormalText"/>
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource AJut_Color_HighlightText}"/>
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <StaticResource x:Key="ButtonBackground" ResourceKey="AJut_Brush_ControlBackground"/>
    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AJut_Brush_ControlBackgroundHover"/>
    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AJut_Brush_ButtonBackgroundPressed"/>
    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="AJut_Brush_ButtonBorder"/>
    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AJut_Brush_ButtonBorderHover"/>
    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AJut_Brush_ButtonBorder"/>
    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="AJut_Brush_ButtonBorder"/>
    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AJut_Brush_ControlBackgroundDisabled"/>

    <!-- ===[ ToggleButton ]=== -->
    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="AJut_Brush_ControlBackground"/>
    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="AJut_Brush_ControlBackgroundHover"/>
    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="AJut_Brush_ButtonBackgroundPressed"/>
    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AJut_Brush_PrimaryHighlight"/>
    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AJut_Brush_PrimaryHighlightBright"/>
    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <StaticResource x:Key="ToggleButtonForeground" ResourceKey="AJut_Brush_NormalText"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{ThemeResource AJut_Color_HighlightText}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource AJut_Color_HighContrastText}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="AJut_Brush_ButtonBorder"/>
    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="AJut_Brush_ButtonBorderHover"/>
    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="AJut_Brush_ButtonBorderPressed"/>
    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="AJut_Brush_ButtonBorderPressed"/>
    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="AJut_Brush_ButtonBorder"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="AJut_Brush_ButtonBorderPressed"/>
    <StaticResource x:Key="ToggleButtonBackgroundDisabled" ResourceKey="AJut_Brush_ControlBackgroundDisabled"/>
    <StaticResource x:Key="ToggleButtonBorderBrushDisabled" ResourceKey="AJut_Brush_ButtonBorder"/>
    <!-- Checked and disabled keeps the checked look in a muted highlight, so it reads as on but not in use -->
    <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="AJut_Brush_PrimaryHighlightDesat"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="AJut_Brush_ButtonBorderPressed"/>

    <!-- ===[ RepeatButton ]=== -->
    <!-- The same as Button; BumpStack's bump buttons are stock RepeatButtons -->
    <StaticResource x:Key="RepeatButtonBackground" ResourceKey="AJut_Brush_ControlBackground"/>
    <StaticResource x:Key="RepeatButtonBackgroundPointerOver" ResourceKey="AJut_Brush_ControlBackgroundHover"/>
    <StaticResource x:Key="RepeatButtonBackgroundPressed" ResourceKey="AJut_Brush_ButtonBackgroundPressed"/>
    <StaticResource x:Key="RepeatButtonBackgroundDisabled" ResourceKey="AJut_Brush_ControlBackgroundDisabled"/>
    <StaticResource x:Key="RepeatButtonForeground" ResourceKey="AJut_Brush_NormalText"/>
    <SolidColorBrush x:Key="RepeatButtonForegroundPointerOver" Color="{ThemeResource AJut_Color_HighlightText}"/>
    <SolidColorBrush x:Key="RepeatButtonForegroundPressed" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <SolidColorBrush x:Key="RepeatButtonForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <StaticResource x:Key="RepeatButtonBorderBrush" ResourceKey="AJut_Brush_ButtonBorder"/>
    <StaticResource x:Key="RepeatButtonBorderBrushPointerOver" ResourceKey="AJut_Brush_ButtonBorderHover"/>
    <StaticResource x:Key="RepeatButtonBorderBrushPressed" ResourceKey="AJut_Brush_ButtonBorder"/>
    <StaticResource x:Key="RepeatButtonBorderBrushDisabled" ResourceKey="AJut_Brush_ButtonBorder"/>

    <!-- ===[ ComboBox ]=== -->
    <StaticResource x:Key="ComboBoxBackground" ResourceKey="AJut_Brush_PopOutControlBackground"/>
    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="AJut_Brush_ControlBackgroundHover"/>
    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="AJut_Brush_ButtonBackgroundPressed"/>
    <StaticResource x:Key="ComboBoxForeground" ResourceKey="AJut_Brush_InteractiveTextUnfocused"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{ThemeResource AJut_Color_HighlightText}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{ThemeResource AJut_Color_InteractiveText}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="AJut_Brush_TextBoxBorder"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{ThemeResource AJut_Color_PrimaryHighlightBright}"/>
    <StaticResource x:Key="ComboBoxBorderBrushFocused" ResourceKey="AJut_Brush_PrimaryHighlight"/>
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="AJut_Brush_InnerPanelBackground"/>
    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="AJut_Brush_ListSelection"/>
    <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="AJut_Brush_NormalText"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="{ThemeResource AJut_Color_HighlightText}"/>
    <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="AJut_Brush_ListSelectionBackground"/>
    <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="AJut_Brush_ListSelection"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="AJut_Brush_ControlBackgroundDisabled"/>
    <StaticResource x:Key="ComboBoxBackgroundFocused" ResourceKey="AJut_Brush_PopOutControlBackground"/>
    <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="AJut_Brush_PrimaryHighlight"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="{ThemeResource AJut_Color_InteractiveText}"/>
    <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="{ThemeResource AJut_Color_InteractiveText}"/>
    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="AJut_Brush_PrimaryHighlight"/>
    <StaticResource x:Key="ComboBoxBorderBrushDisabled" ResourceKey="AJut_Brush_TextBoxBorder"/>
    <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="AJut_Brush_SymbolForeground"/>
    <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="AJut_Brush_SymbolForegroundHighlight"/>
    <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="AJut_Brush_SymbolForegroundPressed"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <StaticResource x:Key="ComboBoxDropDownForeground" ResourceKey="AJut_Brush_NormalText"/>
    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent"/>
    <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedUnfocused" ResourceKey="AJut_Brush_ListSelection"/>
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="AJut_Brush_ListItemHover"/>
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPressed" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedUnfocused" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <!-- An item's outline is its fill, in each state -->
    <StaticResource x:Key="ComboBoxItemBorderBrushPointerOver" ResourceKey="AJut_Brush_ListSelectionBackground"/>
    <StaticResource x:Key="ComboBoxItemBorderBrushPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <StaticResource x:Key="ComboBoxItemBorderBrushSelected" ResourceKey="AJut_Brush_ListSelection"/>
    <StaticResource x:Key="ComboBoxItemBorderBrushSelectedUnfocused" ResourceKey="AJut_Brush_ListSelection"/>
    <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPointerOver" ResourceKey="AJut_Brush_ListItemHover"/>
    <StaticResource x:Key="ComboBoxItemBorderBrushSelectedPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>

    <!-- ===[ Flyout ]=== -->
    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="AJut_Brush_InnerPanelBackground"/>
    <StaticResource x:Key="FlyoutBorderThemeBrush" ResourceKey="AJut_Brush_ListSelection"/>

    <!-- ===[ ColorPicker sliders ]=== -->
    <StaticResource x:Key="ColorPickerSliderThumbBackground" ResourceKey="AJut_Brush_NormalText"/>
    <SolidColorBrush x:Key="ColorPickerSliderThumbBackgroundPointerOver" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <StaticResource x:Key="ColorPickerSliderThumbBackgroundPressed" ResourceKey="AJut_Brush_PrimaryHighlight"/>
    <StaticResource x:Key="SliderOuterThumbBackground" ResourceKey="AJut_Brush_ControlBackground"/>
    <StaticResource x:Key="SliderThumbBorderBrush" ResourceKey="AJut_Brush_ButtonBorder"/>

    <!-- ===[ NumberBox (backing NumericEditor) ]=== -->
    <!-- NumberBoxBackground intentionally NOT overridden here - NumericEditor handles it via TemplateBinding -->
    <StaticResource x:Key="NumberBoxForeground" ResourceKey="AJut_Brush_NormalText"/>
    <StaticResource x:Key="NumberBoxBorderBrush" ResourceKey="AJut_Brush_TextBoxBorder"/>
    <StaticResource x:Key="NumberBoxBorderBrushFocused" ResourceKey="AJut_Brush_PrimaryHighlight"/>
    <SolidColorBrush x:Key="NumberBoxButtonBackground" Color="Transparent"/>
    <StaticResource x:Key="NumberBoxButtonBackgroundPointerOver" ResourceKey="AJut_Brush_MouseInteractionHighlight"/>
    <StaticResource x:Key="NumberBoxButtonBackgroundPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <StaticResource x:Key="NumberBoxButtonForeground" ResourceKey="AJut_Brush_SymbolForeground"/>
    <StaticResource x:Key="NumberBoxButtonForegroundPointerOver" ResourceKey="AJut_Brush_SymbolForegroundHighlight"/>
    <StaticResource x:Key="NumberBoxButtonForegroundPressed" ResourceKey="AJut_Brush_SymbolForegroundHighlight"/>
    <!-- What a NumberBox shows beyond the text box and repeat button keys: its disabled header and placeholder, its description, and its spin button popup -->
    <SolidColorBrush x:Key="TextControlHeaderForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{ThemeResource AJut_Color_UnderstatedText}"/>
    <StaticResource x:Key="SystemControlDescriptionTextForegroundBrush" ResourceKey="AJut_Brush_UnderstatedText"/>
    <StaticResource x:Key="NumberBoxPopupBackground" ResourceKey="AJut_Brush_InnerPanelBackground"/>
    <StaticResource x:Key="NumberBoxPopupBorderBrush" ResourceKey="AJut_Brush_ListSelection"/>
    <StaticResource x:Key="NumberBoxPopupIndicatorForeground" ResourceKey="AJut_Brush_SymbolForeground"/>

    <!-- ===[ ToggleSwitch ]=== -->
    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AJut_Brush_PrimaryHighlight"/>
    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AJut_Brush_PrimaryHighlightBright"/>
    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#EEEEEE"/>
    <StaticResource x:Key="ToggleSwitchFillOff" ResourceKey="AJut_Brush_InnerPanelBackground"/>
    <!-- The Windows App SDK 1.8 template animates the off track's fill and stroke with color key frames from pointer
         over on, so these take palette Colors; a brush here fails when the animation runs -->
    <StaticResource x:Key="ToggleSwitchFillOffPointerOver" ResourceKey="AJut_Color_InnerPanelBackgroundHover"/>
    <StaticResource x:Key="ToggleSwitchFillOffPressed" ResourceKey="AJut_Color_InnerPanelBackground"/>
    <StaticResource x:Key="ToggleSwitchStrokeOff" ResourceKey="AJut_Brush_BorderCommon"/>
    <StaticResource x:Key="ToggleSwitchStrokeOffPointerOver" ResourceKey="AJut_Color_BorderCommonHover"/>
    <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="AJut_Brush_PrimaryHighlightDark"/>
