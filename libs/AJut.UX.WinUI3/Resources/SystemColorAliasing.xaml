    <StaticResource x:Key="ScrollBarPanningThumbBackground" ResourceKey="AJut_Brush_BorderCommonHover"/>
    <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="Transparent"/>
    <StaticResource x:Key="ScrollBarThumbFillDisabled" ResourceKey="AJut_Brush_BorderCommon"/>
    <StaticResource x:Key="ScrollBarPanningThumbBackgroundDisabled" ResourceKey="AJut_Brush_BorderCommon"/>

