    <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxBorderBrushUncheckedPointerOver" Color="Transparent"/>
    <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="AJut_Brush_TextBoxBackground"/>
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedPointerOver" ResourceKey="AJut_Brush_ImportantText"/>
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedPressed" Color="{ThemeResource AJut_Color_ImportantText}"/>
    <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedPressed" Color="Transparent"/>
