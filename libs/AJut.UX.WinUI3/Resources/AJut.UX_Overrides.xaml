<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:ajut="using:AJut.UX.Controls">
    <!-- The themed layer of the window chrome. The control's own style carries literal defaults so it looks sane with
         no theme loaded; this layer swaps every chrome brush for the palette's when the AJut theme is loaded. -->
    <Style TargetType="ajut:ThemedWindowRootControl">
        <Setter Property="ActiveTitleBarBackground" Value="{ThemeResource AJut_Brush_TitleBarBackground}"/>
        <Setter Property="InactiveTitlebarBackground" Value="{ThemeResource AJut_Brush_TitleBarBackgroundInactive}"/>
        <Setter Property="InactiveBorderBrush" Value="{ThemeResource AJut_Brush_WindowGlowBorderInactive}"/>
        <Setter Property="CloseHoverBorderBrush" Value="{ThemeResource AJut_Brush_ChromeCloseButtonComplement}"/>
        <Setter Property="CaptionButtonHoverBackground" Value="{ThemeResource AJut_Brush_ChromeButtonHoverBackground}"/>
        <Setter Property="CaptionButtonPressedBackground" Value="{ThemeResource AJut_Brush_ChromeButtonPressedBackground}"/>
        <Setter Property="CloseButtonHoverBackground" Value="{ThemeResource AJut_Brush_ChromeCloseButtonHoverBackground}"/>
        <Setter Property="CloseButtonPressedBackground" Value="{ThemeResource AJut_Brush_ChromeCloseButtonPressedBackground}"/>
    </Style>
</ResourceDictionary>
