<?xml version="1.0" encoding="utf-8"?>
<!--
    DarkTouchThemeColorsBase.xaml
    =============================
    The dark palette for touch. Touch has no hover, so a button has to read as one from its fill alone: button
    surfaces lift off the panels (a disabled button's does not), button borders come off, and text is brighter.
    Everything not stated here is the dark palette's, merged in below.

    A key changed here is stated in full here, and so is any brush in the dark palette that takes its color from it,
    since a brush defined in the merged dark palette looks its color up there and not here.

    TouchThemeColors.xaml puts this in an app's dark theme when AppThemeManager.IsTouchFocused is on. AJut.UX's
    AJutPalette.DarkTouch mirrors this file, and a test keeps the two in step.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///AJut.UX.WinUI3/Resources/DarkThemeColorsBase.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ================[ Text ]====================== -->
    <Color x:Key="AJut_Color_NormalText">#DDD</Color>
    <SolidColorBrush x:Key="AJut_Brush_NormalText" Color="{ThemeResource AJut_Color_NormalText}" />

    <!-- ================[ Button surfaces ]====================== -->
    <SolidColorBrush x:Key="AJut_Brush_ControlBackground" Color="#2E4157"/>
    <LinearGradientBrush x:Key="AJut_Brush_PopOutControlBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.00" Color="#7A8AA0" />
        <GradientStop Offset="0.05" Color="#3D5168" />
        <GradientStop Offset="0.90" Color="#2E4157" />
        <GradientStop Offset="1.00" Color="#141C26" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AJut_Brush_ControlBackgroundHover" Color="#38506B"/>
    <SolidColorBrush x:Key="AJut_Brush_ButtonBackgroundPressed" Color="#0B4F80"/>
    <!-- Not lifted: the dark palette's own control surface, so a disabled button does not read as a tap target -->
    <SolidColorBrush x:Key="AJut_Brush_ControlBackgroundDisabled" Color="#111117"/>

    <!-- ================[ Button borders ]====================== -->
    <Color x:Key="AJut_Color_ButtonBorder">#00000000</Color>
    <SolidColorBrush x:Key="AJut_Brush_ButtonBorder" Color="{ThemeResource AJut_Color_ButtonBorder}"/>
    <SolidColorBrush x:Key="AJut_Brush_ButtonBorderHover" Color="#00000000"/>
    <SolidColorBrush x:Key="AJut_Brush_ButtonBorderPressed" Color="#00000000"/>
</ResourceDictionary>
