        <Setter Property="Background" Value="{DynamicResource AJut_Brush_TitleBarBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_TitleBarForeground}"/>
        <Setter Property="NavButtonForeground" Value="{DynamicResource AJut_Brush_TitleBarForeground}"/>
        <!-- The back and drawer buttons are title bar buttons, so they take the chrome buttons' hover and press, as the
             window's own buttons beside them do -->
        <Setter Property="NavButtonForegroundHighlight" Value="{DynamicResource AJut_Brush_ChromeButtonHoverForeground}"/>
        <Setter Property="NavButtonBackgroundHover" Value="{DynamicResource AJut_Brush_ChromeButtonHoverBackground}"/>
        <Setter Property="NavButtonBackgroundPressed" Value="{DynamicResource AJut_Brush_ChromeButtonPressedBackground}"/>
        <Style.Triggers>
            <!-- The header is the title bar of a window built on a StackNavDisplay, so it goes to the inactive title bar
                 color with its window, as the themed window's frame does -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=IsActive}" Value="False">
                <Setter Property="Background" Value="{DynamicResource AJut_Brush_TitleBarBackgroundInactive}"/>
