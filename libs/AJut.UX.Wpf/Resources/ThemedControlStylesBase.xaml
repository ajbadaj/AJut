        <Setter Property="ButtonPressedBackground" Value="{DynamicResource AJut_Brush_ChromeButtonPressedBackground}"/>
        <Setter Property="ButtonPressedBorder" Value="{DynamicResource AJut_Brush_Rimlighting}"/>
