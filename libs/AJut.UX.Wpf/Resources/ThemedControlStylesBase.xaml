<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ajut="clr-namespace:AJut.UX"
                    xmlns:ajut_ctrls="clr-namespace:AJut.UX.Controls"
                    xmlns:ajut_ap="clr-namespace:AJut.UX.AttachedProperties"
                    xmlns:ajut_conv="clr-namespace:AJut.UX.Converters"
                    xmlns:ajut_themext="clr-namespace:AJut.UX.Theming.AJutStyleExtensionsForBuiltInWpfControls"
                    xmlns:ajut_theme="clr-namespace:AJut.UX.Theming"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">


    <FontFamily x:Key="AJut_Font_Default">Segoe UI</FontFamily>

    <FontFamily x:Key="AJut_Font_SymbolGlyphText">Segoe MDL2 Assets</FontFamily>
    <sys:String x:Key="AJut_Symbol_Check">&#xE73E;</sys:String>
    <sys:String x:Key="AJut_Symbol_Dash">&#xE9AE;</sys:String>
    <sys:String x:Key="AJut_Symbol_NeedsEdit">&#xEB7E;</sys:String>

    <sys:String x:Key="AJut_Symbol_UpChevron"   >&#xE70E;</sys:String>
    <sys:String x:Key="AJut_Symbol_DownChevron" >&#xE70D;</sys:String>
    <sys:String x:Key="AJut_Symbol_LeftChevron" >&#xE76B;</sys:String>
    <sys:String x:Key="AJut_Symbol_RightChevron" >&#xE76C;</sys:String>

    <PathGeometry x:Key="AJut_PathGeom_SliderUpFacing" Figures="M0,6C0,6 5.5,0 5.5,0 5.5,0 11,6 11,6 11,6 11,18 11,18 11,18 0,18 0,18 0,18 0,6 0,6z"/>
    <PathGeometry x:Key="AJut_PathGeom_SliderDownFacing"  Figures="M0,12C0,12 5.5,18 5.5,18 5.5,18 11,12 11,12 11,12 11,0 11,0 11,0 0,0 0,0 0,0 0,12 0,12z"/>
    <PathGeometry x:Key="AJut_PathGeom_SliderUpDownFacing" Figures="M0,0C0,0 11,0 11,0 11,0 11,18 11,18 11,18 0,18 0,18 0,18 0,0 0,0z"/>

    <PathGeometry x:Key="AJut_PathGeom_SliderLeftFacing" Figures="M6,11C6,11 0,5.5 0,5.5 0,5.5 6,0 6,0 6,0 18,0 18,0 18,0 18,11 18,11 18,11 6,11 6,11z"/>
    <PathGeometry x:Key="AJut_PathGeom_SliderRightFacing" Figures="M12,11C12,11 18,5.5 18,5.5 18,5.5 12,0 12,0 12,0 0,0 0,0 0,0 0,11 0,11 0,11 12,11 12,11z"/>
    <PathGeometry x:Key="AJut_PathGeom_SliderLeftRightFacing" Figures="M0.5,0.5L18.5,0.5 18.5,11.5 0.5,11.5z"/>


    <!-- What keyboard focus draws on a control: the stock dotted outline's shape, in the palette's bright highlight.
         Every themed style of a control that can take keyboard focus sets it, since WPF looks the default one up in
         the system theme only, past the app's resources. -->
    <Style x:Key="AJut_Style_FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" StrokeThickness="1" StrokeDashArray="1 2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource AJut_Brush_PrimaryHighlightBright}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AJut_Style_DefaultTextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource Self}, Path=(TextElement.FontFamily)}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TextBlock}}, Path=(TextElement.Foreground), Converter={ajut_conv:NullnessChecker}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AJut_Style_HeaderTextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="Thin"/>
        <Setter Property="FontFamily" Value="Century Gothic"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TextBlock}}, Path=(TextElement.Foreground), Converter={ajut_conv:NullnessChecker}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AJut_Style_DefaultTextBlock}"/>
    <Style TargetType="{x:Type ajut_ctrls:EditableTextBlock}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
    </Style>

    <Style TargetType="{x:Type AccessText}">
        <Setter Property="FontFamily" Value="{Binding RelativeSource={RelativeSource Self}, Path=(TextElement.FontFamily)}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TextBlock}}, Path=(TextElement.Foreground), Converter={ajut_conv:NullnessChecker}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:NumericEditor}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_PopOutControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_TextBoxBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_SymbolForeground}"/>
        <Setter Property="ErrorBrush" Value="{DynamicResource AJut_Brush_BadStuff}"/>
        <!-- The nudge buttons sit over the label, so the hover fill is a wash of the bright highlight the label shows
             through. Pressed keeps the default style's pushed-in gradient: it is translucent shading rather than a color, so
             it suits either palette and the label still shows through it, the same as WinUI3's. -->
        <Setter Property="IncreaseHoverHighlight">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource AJut_Color_PrimaryHighlightBright}" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
        <Setter Property="DecreaseHoverHighlight">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource AJut_Color_PrimaryHighlightBright}" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
        <Setter Property="InsetShadowBrush" Value="{DynamicResource AJut_Brush_Shadow}"/>
        <Setter Property="InsetHighlightBrush" Value="{DynamicResource AJut_Brush_Rimlighting}"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="LabelPadding" Value="4"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <!-- Focus and hover show on the border only; the label glyph keeps its color -->
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlight}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlightBright}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The selected item is tinted with the primary highlight and keeps the strip's text color. Hover, over any item, is
         the full primary highlight with the light text that sits on it, so hover and selection read as one color. -->
    <Style TargetType="{x:Type ajut_ctrls:ToggleStrip}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="OverflowPopupBackground" Value="{DynamicResource AJut_Brush_PopupBackground}"/>
        <Setter Property="OverflowPopupBorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_OverlayBlockoutBackground}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_PopOutControlBackground}" />
        <Setter Property="BackgroundPressedColorBase" Value="{DynamicResource AJut_Color_PrimaryHighlight}"/>
        <Setter Property="BackgroundHover" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="BackgroundHoverOverPressed" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="SeparatorThickness" Value="1"/>
        <Setter Property="SeparatorBrush" Value="{DynamicResource AJut_Brush_OverlayBlockoutBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="ForegroundHover" Value="{DynamicResource AJut_Brush_HighContrastText}"/>
        <Setter Property="ForegroundPressed" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <!-- Disabled, as the themed ComboBox: the flat disabled fill, the common border and the understated text -->
        <Setter Property="DisabledBackground" Value="{DynamicResource AJut_Brush_ControlBackgroundDisabled}"/>
        <Setter Property="DisabledBorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="DisabledForeground" Value="{DynamicResource AJut_Brush_UnderstatedText}"/>
        <!-- The selected item, muted: a faded, desaturated primary -->
        <Setter Property="DisabledSelectedBackground">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource AJut_Color_PrimaryHighlightDesat}" Opacity="0.55"/>
            </Setter.Value>
        </Setter>
        <!-- Vertical, the scroll and overflow buttons take the plain button colors, as WinUI3's do -->
        <Setter Property="VerticalButtonBackground" Value="{DynamicResource AJut_Brush_ControlBackground}"/>
        <Setter Property="VerticalButtonForeground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="VerticalButtonBorderBrush" Value="{DynamicResource AJut_Brush_ButtonBorder}"/>
    </Style>

    <!-- EnumToggleStrip hands its own brushes to its inner ToggleStrip as local values, which win over the themed
         ToggleStrip style above, so it needs the same themed brushes itself. Keep the two in step. -->
    <Style TargetType="{x:Type ajut_ctrls:EnumToggleStrip}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_OverlayBlockoutBackground}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_PopOutControlBackground}" />
        <Setter Property="BackgroundPressedColorBase" Value="{DynamicResource AJut_Color_PrimaryHighlight}"/>
        <Setter Property="BackgroundHover" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="BackgroundHoverOverPressed" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="SeparatorThickness" Value="1"/>
        <Setter Property="SeparatorBrush" Value="{DynamicResource AJut_Brush_OverlayBlockoutBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="ForegroundHover" Value="{DynamicResource AJut_Brush_HighContrastText}"/>
        <Setter Property="ForegroundPressed" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="DisabledBackground" Value="{DynamicResource AJut_Brush_ControlBackgroundDisabled}"/>
        <Setter Property="DisabledBorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="DisabledForeground" Value="{DynamicResource AJut_Brush_UnderstatedText}"/>
        <!-- The selected item, muted: a faded, desaturated primary -->
        <Setter Property="DisabledSelectedBackground">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource AJut_Color_PrimaryHighlightDesat}" Opacity="0.55"/>
            </Setter.Value>
        </Setter>
        <!-- Vertical, the scroll and overflow buttons take the plain button colors, as WinUI3's do -->
        <Setter Property="VerticalButtonBackground" Value="{DynamicResource AJut_Brush_ControlBackground}"/>
        <Setter Property="VerticalButtonForeground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="VerticalButtonBorderBrush" Value="{DynamicResource AJut_Brush_ButtonBorder}"/>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:FlatTreeListControl}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AJut_Brush_TreeSelection}"/>
        <Setter Property="SelectionInactiveBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlightDesat}"/>
        <Setter Property="ExpandCollapseGlyphSize" Value="10"/>
        <Setter Property="GlyphBrush" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="GlyphHighlightBrush" Value="{DynamicResource AJut_Brush_SymbolForegroundHighlight}"/>
        <Setter Property="GlyphBackgroundHighlightBrush" Value="{DynamicResource AJut_Brush_MouseInteractionHighlight}"/>
        <Setter Property="InsertionLineBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="ParentConnectorBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlightDesat}"/>
        <Setter Property="DragTargetHighlightBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="DragGhostBackground" Value="{DynamicResource AJut_Brush_PopupBackground}"/>
        <Setter Property="DragGhostBorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="DragGhostForeground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_ListBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_ListBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="ListBoxItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=(ajut_ap:BorderXTA.CornerRadius)}"
                                        IsHitTestVisible="True">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Background="{TemplateBinding BorderBrush}" Width="10"
                                              Visibility="{Binding Path=IsSelected, Converter={ajut_conv:BooleanToVisibilityConverter TrueValue=Visible, FalseValue=Hidden}}"/>
                                        <ContentPresenter Content="{Binding}" 
                                                          ContentTemplate="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=ItemTemplate}" 
                                                          ContentTemplateSelector="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=ItemTemplateSelector}" 
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </DockPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelectable}" Value="True" />
                                <Condition Binding="{Binding Path=IsSelected}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(Selector.IsSelectionActive)}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ajut_ctrls:FlatTreeListControl}}, Path=SelectionBrush}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelectable}" Value="True" />
                                <Condition Binding="{Binding Path=IsSelected}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(Selector.IsSelectionActive)}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ajut_ctrls:FlatTreeListControl}}, Path=SelectionInactiveBrush}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsSelectable}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ajut_themext:AJutThemedListControlXTA.ListItemsShowHover)}"  Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_ListItemHover}"/>
                            <Setter Property="Background" Value="{DynamicResource AJut_Brush_ListSelectionBackground}"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:PropertyGrid}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_ListBorder}" />
        <Setter Property="LabelSplitterBrush" Value="{DynamicResource AJut_Brush_ListSelection}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_ListBackground}"/>
        <Setter Property="TextLabelStyle">
            <Setter.Value>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AJut_Style_DefaultTextBlock}">
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="Opacity" Value="0.8" />
                </Style>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource AJut_Double_StandardDisabledOpacity}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The color controls' swatch shows a translucent color over a backing striped with lines, so its transparency
         reads. Themed, the stripes are the palette's shadow over the text box fill. -->
    <Style TargetType="{x:Type ajut_ctrls:ColorEditIngressControl}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="HighlightBorderBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="PopupWidth" Value="275"/>
        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_InnerPanelBackground}"/>
        <Setter Property="BackingFillBrush" Value="{DynamicResource AJut_Brush_TextBoxBackground}"/>
        <Setter Property="TransparencyLinesBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="5,5" MappingMode="Absolute" SpreadMethod="Reflect">
                    <GradientStop Offset="0.00" Color="{DynamicResource AJut_Color_Shadow}" />
                    <GradientStop Offset="0.10" Color="{DynamicResource AJut_Color_Shadow}" />
                    <GradientStop Offset="0.10" Color="Transparent" />
                    <GradientStop Offset="0.90" Color="Transparent" />
                    <GradientStop Offset="0.90" Color="{DynamicResource AJut_Color_Shadow}" />
                    <GradientStop Offset="1.00" Color="{DynamicResource AJut_Color_Shadow}" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <!-- Shadow over the top half, rim light over the bottom, faded down to a sheen. Each half fades from clear of
             its own shade (clear black, then clear white), so neither picks up a gray haze on the way. -->
        <Setter Property="CoverGlossBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" Opacity="0.3">
                    <GradientStop Offset="0.00" Color="#00000000" />
                    <GradientStop Offset="0.50" Color="{DynamicResource AJut_Color_Shadow}" />
                    <GradientStop Offset="0.50" Color="{DynamicResource AJut_Color_RimLighting}" />
                    <GradientStop Offset="1.00" Color="Transparent" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerBannerForeground" Value="{DynamicResource AJut_Brush_SymbolForegroundHighlight}"/>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:ColorValueEditControl}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_InnerPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="BackingFillBrush" Value="{DynamicResource AJut_Brush_TextBoxBackground}"/>
        <Setter Property="TransparencyLinesBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="5,5" MappingMode="Absolute" SpreadMethod="Reflect">
                    <GradientStop Offset="0.00" Color="{DynamicResource AJut_Color_Shadow}" />
                    <GradientStop Offset="0.10" Color="{DynamicResource AJut_Color_Shadow}" />
                    <GradientStop Offset="0.10" Color="Transparent" />
                    <GradientStop Offset="0.90" Color="Transparent" />
                    <GradientStop Offset="0.90" Color="{DynamicResource AJut_Color_Shadow}" />
                    <GradientStop Offset="1.00" Color="{DynamicResource AJut_Color_Shadow}" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The overlay that dims the editor while the value is null -->
    <Style TargetType="{x:Type ajut_ctrls:NullableEditor}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="OverlayBackground" Value="{DynamicResource AJut_Brush_Shadow}"/>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:PathSelectionControl}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_PopOutControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_TextBoxBorder}"/>
        <Setter Property="TextBoxBorderBrush" Value="{DynamicResource AJut_Brush_Shadow}"/>
        <Setter Property="FocusedBorderBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="InvalidPathBorderBrush" Value="{DynamicResource AJut_Brush_BadStuff}"/>
        <Setter Property="InvalidForegroundSymbol" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="ButtonBackground" Value="{DynamicResource AJut_Brush_PopOutControlBackground}"/>
        <Setter Property="ButtonForeground" Value="{DynamicResource AJut_Brush_SymbolForeground}"/>
        <Setter Property="ButtonHoverBackground" Value="{DynamicResource AJut_Brush_PrimaryHighlightBright}"/>
        <Setter Property="ButtonHoverForeground" Value="{DynamicResource AJut_Brush_HighlightText}"/>
        <Setter Property="ButtonPressedBackground" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="ButtonPressedForeground" Value="{DynamicResource AJut_Brush_HighlightText}"/>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:DockZone}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="PanelBackground" Value="{DynamicResource AJut_Brush_PanelBackground}"/>
        <Setter Property="PanelBorderBrush" Value="{DynamicResource AJut_Brush_PanelBorder}"/>
        <Setter Property="PanelBorderThickness" Value="1"/>
        <Setter Property="PanelCornerRadius" Value="0,10,0,10"/>
        <Setter Property="SeparatorBrush" Value="Transparent" />
    </Style>

    <!-- The panel header and the unselected panel tabs frame a dock panel on the navigation level; the
         panel and its selected tab are on the panel color -->
    <Style TargetType="{x:Type ajut_ctrls:DockZoneSelectedHeaderControl}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_PanelBorder}"/>
        <Setter Property="HeaderBackground" Value="{DynamicResource AJut_Brush_NavigationPanelBackground}"/>
        <Setter Property="HeaderHighlightBackground" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="HeaderFocusedBackground" Value="{DynamicResource AJut_Brush_PrimaryHighlightDark}"/>

        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_BannerForeground}"/>
        <!-- Under the pointer and while its panel has focus the header fills with the primary highlight, so its title
             takes the light text the theme puts on that highlight -->
        <Setter Property="HeaderHighlightedForeground" Value="{DynamicResource AJut_Brush_HighContrastText}"/>
        <Setter Property="HeaderFocusedForeground" Value="{DynamicResource AJut_Brush_HighContrastText}"/>

        <Setter Property="FontSize" Value="18"/>
    </Style>
    
    <Style TargetType="{x:Type ajut_ctrls:DockZoneTabHeadersControl}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HeaderBackground" Value="{DynamicResource AJut_Brush_NavigationPanelBackground}"/>
        <Setter Property="HeaderSelectedBackground" Value="{DynamicResource AJut_Brush_PanelBackground}"/>
        <Setter Property="HeaderHighlightBackground" Value="{DynamicResource AJut_Brush_PrimaryHighlightDesat}"/>
        <Setter Property="HeaderBorder" Value="{DynamicResource AJut_Brush_PanelBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource AJut_Brush_HighContrastText}"/>
        <Setter Property="TabPanelHeaderMargin" Value="8,-1,3,0"/>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:DockDropInsertionDriverWidget}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_InnerPanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="GlyphBrush" Value="{DynamicResource AJut_Brush_TitleBarForeground}"/>
        <Setter Property="GlyphBorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>

        <Setter Property="BackgroundHighlighted" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="BorderHighlighted" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="GlyphHighlightedBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlightDark}"/>
        <Setter Property="GlyphHighlightedBorderBrush" Value="{DynamicResource AJut_Brush_PrimaryHighlightDesat}"/>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:DockWholeWindowDragStartControl}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="GlyphBrush" Value="{DynamicResource AJut_Brush_SymbolForeground}"/>
        <Setter Property="GlyphBrushHighlighted" Value="{DynamicResource AJut_Brush_SymbolForegroundHighlight}"/>
        <Setter Property="BackgroundBrushHighlighted" Value="{DynamicResource AJut_Brush_PrimaryHighlight}"/>
        <Setter Property="BorderBrushHighlighted" Value="{DynamicResource AJut_Brush_Shadow}"/>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:WindowChromeButtonStrip}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="ButtonPadding" Value="12" />
        <Setter Property="ButtonGlyphFontSize" Value="10" />
        <Setter Property="ButtonBorder" Value="Transparent"/>
        <Setter Property="ButtonBackground" Value="#01000000"/>
        <Setter Property="ButtonGlyphForeground" Value="{DynamicResource AJut_Brush_TitleBarForeground}"/>
        <!-- Square, as Windows' own caption buttons and WinUI3's are -->
        <Setter Property="ButtonCornerRadius" Value="0"/>

        <!-- Under the pointer a button sinks into shadow, and pressed it catches the light -->
