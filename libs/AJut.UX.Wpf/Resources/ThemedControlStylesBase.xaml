        <Setter Property="OptionButtonStyle" Value="{DynamicResource AJut_Style_MessageBoxButton}"/>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:ToggleSwitchButton}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="Background" Value="{DynamicResource AJut_Brush_InnerPanelBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>

        <Setter Property="ForegroundWhenTrue" Value="{DynamicResource AJut_Brush_HighContrastText}"/>

        <Setter Property="BorderBrushWhenTrue" Value="{DynamicResource AJut_Brush_PrimaryHighlightDark}"/>
        <Setter Property="BackgroundWhenTrue">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                    <GradientStop Offset="0.00" Color="{DynamicResource AJut_Color_PrimaryHighlightDark}" />
                    <GradientStop Offset="0.25" Color="{DynamicResource AJut_Color_PrimaryHighlightDesat}" />
                    <GradientStop Offset="0.75" Color="{DynamicResource AJut_Color_PrimaryHighlight}" />
                    <GradientStop Offset="1.00" Color="{DynamicResource AJut_Color_PrimaryHighlightDesat}" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>

        <Setter Property="SwitchBackground" Value="{DynamicResource AJut_Brush_ControlBackground}"/>
        <Setter Property="SwitchBorderBrush" Value="{DynamicResource AJut_Brush_BorderCommon}"/>
        <Setter Property="SwitchBorderThickness" Value="1"/>
        <Setter Property="SwitchBorderCornerRadius" Value="2"/>
        <Setter Property="SwitchBackgroundHover" Value="{DynamicResource AJut_Brush_ControlBackgroundHover}"/>
        <Setter Property="SwitchBorderBrushHover" Value="{DynamicResource AJut_Brush_BorderCommonHover}"/>
        <Setter Property="SwitchPadding" Value="-2"/>
        <Setter Property="ContentForeground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <!-- Disabled, the text goes understated and an on switch drops its shaded blue for the dark primary; the template
             fades the switch itself -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="ContentForeground" Value="{DynamicResource AJut_Brush_UnderstatedText}"/>
                <Setter Property="BackgroundWhenTrue" Value="{DynamicResource AJut_Brush_PrimaryHighlightDark}"/>
                <Setter Property="BorderBrushWhenTrue" Value="{DynamicResource AJut_Brush_PrimaryHighlightDark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ajut_ctrls:BrushButton}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource AJut_Style_FocusVisual}"/>
        <Setter Property="NormalBackground" Value="{DynamicResource AJut_Brush_ControlBackground}"/>
        <Setter Property="NormalForeground" Value="{DynamicResource AJut_Brush_NormalText}"/>
        <Setter Property="NormalBorderBrush" Value="{DynamicResource AJut_Brush_ButtonBorder}"/>
        <Setter Property="PointerOverBackground" Value="{DynamicResource AJut_Brush_ControlBackgroundHover}"/>
        <Setter Property="PointerOverForeground" Value="{DynamicResource AJut_Brush_HighlightText}"/>
        <Setter Property="PointerOverBorderBrush" Value="{DynamicResource AJut_Brush_ButtonBorderHover}"/>
        <Setter Property="PressedBackground" Value="{DynamicResource AJut_Brush_ButtonBackgroundPressed}"/>
        <Setter Property="PressedForeground" Value="{DynamicResource AJut_Brush_HighlightText}"/>
        <Setter Property="PressedBorderBrush" Value="{DynamicResource AJut_Brush_ButtonBorderPressed}"/>
        <Setter Property="DisabledBackground" Value="{DynamicResource AJut_Brush_ControlBackground}"/>
        <Setter Property="DisabledForeground" Value="{DynamicResource AJut_Brush_InteractiveTextUnfocused}"/>
        <Setter Property="DisabledBorderBrush" Value="{DynamicResource AJut_Brush_ButtonBorder}"/>
