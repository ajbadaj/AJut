<!--
    DarkTouchThemeColorsOverlay.xaml
    ================================
    What the dark palette changes for touch, and nothing else. Touch has no hover, so a button has to read as one
    from its fill alone: button surfaces lift off the panels, button borders come off, and text is brighter.

    AppThemeManager.IsTouchFocused lays this over the app's dark theme colors as the application's last merged
    dictionary, so the app's own colors stay for every key this doesn't name. The values are the shared dark touch
    palette's (AJut.UX's AJutPalette.DarkTouch), and a test keeps them in step.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AJut_Brush_NormalText" Color="#DDD" />

    <SolidColorBrush x:Key="AJut_Brush_ControlBackground" Color="#2E4157"/>
    <LinearGradientBrush x:Key="AJut_Brush_PopOutControlBackground"  StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.00" Color="#7A8AA0" />
        <GradientStop Offset="0.05" Color="#3D5168" />
        <GradientStop Offset="0.90" Color="#2E4157" />
        <GradientStop Offset="1.00" Color="#141C26" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AJut_Brush_ControlBackgroundHover" Color="#38506B"/>
    <SolidColorBrush x:Key="AJut_Brush_ButtonBackgroundPressed" Color="#0B4F80"/>

    <SolidColorBrush x:Key="AJut_Brush_ButtonBorder" Color="#00000000"/>
    <SolidColorBrush x:Key="AJut_Brush_ButtonBorderHover" Color="#00000000"/>
    <SolidColorBrush x:Key="AJut_Brush_ButtonBorderPressed" Color="#00000000"/>
</ResourceDictionary>
