<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ajut="clr-namespace:AJut.UX"
                    xmlns:ap="clr-namespace:AJut.UX.AttachedProperties"
                    xmlns:local="clr-namespace:AJut.UX.Controls"
                    xmlns:conv="clr-namespace:AJut.UX.Converters"
                    xmlns:prop="clr-namespace:AJut.UX.PropertyInteraction;assembly=AJut.UX">

    <!-- ===[ PropertyGrid: no-selection ListBoxItem style ]=== -->
    <!-- Suppresses ListBox full-row selection highlight so the label-border selection
         (DataTrigger on IsSelected in the ItemTemplate) is the only visual indicator. -->
    <Style x:Key="PropertyGrid_NoSelectionListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Padding="2" SnapsToDevicePixels="True" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===[ Default subtitle style ]=== -->
    <Style x:Key="PropertyGrid_DefaultSubtitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="Margin" Value="5,0,7,2"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Converter: collapses the subtitle when it is null or empty -->
    <conv:IsTextNullOrEmptyToVisibilityConverter x:Key="PG_SubtitleVisConverter"
                                                  WhenHasText="Visible"
                                                  WhenNullOrEmpty="Collapsed"/>

    <!-- Label icon converters -->
    <conv:StringToImageSourceConverter x:Key="PG_StringToImageSource"/>
    <conv:IsTextNullOrEmptyToVisibilityConverter x:Key="PG_IconVisConverter"
                                                  WhenHasText="Visible"
                                                  WhenNullOrEmpty="Collapsed"/>
    <conv:ThicknessFromNumberConverter x:Key="PG_IconMarginConverter" MultiplyMask="1,1,1,1"/>

    <!-- ===[ Default label templates ]=== -->
    <!-- DefaultValueLabelDataTemplate: normal label (value equals default). DataContext = PropertyEditTarget. -->
    <DataTemplate x:Key="PropertyGrid_DefaultLabelTemplate" DataType="{x:Type prop:PropertyEditTarget}">
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding IconSource, Converter={StaticResource PG_StringToImageSource}}"
                       Visibility="{Binding IconSource, Converter={StaticResource PG_IconVisConverter}}"
                       Margin="{Binding IconMargin, Converter={StaticResource PG_IconMarginConverter}}"
                       MaxHeight="20"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayName}"
                           Margin="5,3,7,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}"
                       Visibility="{Binding Subtitle, Converter={StaticResource PG_SubtitleVisConverter}}"
                       Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Path=LabelSubtitleStyle}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ModifiedValueLabelDataTemplate: bold label (value differs from default). DataContext = PropertyEditTarget. -->
    <DataTemplate x:Key="PropertyGrid_ModifiedLabelTemplate" DataType="{x:Type prop:PropertyEditTarget}">
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding IconSource, Converter={StaticResource PG_StringToImageSource}}"
                       Visibility="{Binding IconSource, Converter={StaticResource PG_IconVisConverter}}"
                       Margin="{Binding IconMargin, Converter={StaticResource PG_IconMarginConverter}}"
                       MaxHeight="20"
                       VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayName}"
                           FontWeight="Bold"
                           Margin="5,3,7,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}"
                       Visibility="{Binding Subtitle, Converter={StaticResource PG_SubtitleVisConverter}}"
                       Style="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Path=LabelSubtitleStyle}"/>
        </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type local:PropertyGrid}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="TextLabelStyle">
            <Setter.Value>
                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Opacity" Value="0.8"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="DefaultValueLabelDataTemplate" Value="{StaticResource PropertyGrid_DefaultLabelTemplate}"/>
        <Setter Property="ModifiedValueLabelDataTemplate" Value="{StaticResource PropertyGrid_ModifiedLabelTemplate}"/>
        <Setter Property="LabelSubtitleStyle" Value="{StaticResource PropertyGrid_DefaultSubtitleStyle}"/>
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="LabelSplitterBrush" Value="#FF2196F3"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PropertyGrid}">
                    <!--
                        RootItemsSource = PropertyTreeItems (top-level PropertyEditTarget items).
                        FlatTreeListControl.CreateUberRoot wraps each in a FlatTreeItem with the
                        uber root always expanded, making all top-level rows immediately visible.
                        Sub-object children start collapsed until the user expands them.
                        Note: the WPF FlatTreeListControl ItemTemplate DataContext is PropertyEditTarget
                        (set by the inner ContentPresenter via Content="{Binding Source}"). To access
                        IndentWidth we walk to the ListBoxItem (DataContext = FlatTreeItem).
                    -->
                    <Grid>
                        <local:FlatTreeListControl x:Name="PART_TreeList"
                                                   RootItemsSource="{ajut:TemplateBinding PropertyTreeItems}"
                                                   Background="{TemplateBinding Background}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                   ap:BorderXTA.CornerRadius="{ajut:TemplateBinding Path=(ap:BorderXTA.CornerRadius)}"
                                                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   TreeDepthIndentSize="{TemplateBinding TreeDepthIndentSize}"
                                                   RowSpacing="{TemplateBinding RowSpacing}"
                                                   FixedRowHeight="{TemplateBinding FixedRowHeight}"
                                                   ListBoxItemContainerStyle="{StaticResource PropertyGrid_NoSelectionListBoxItemStyle}"
                                                   ScrollViewer.HorizontalScrollBarVisibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Path=(ScrollViewer.HorizontalScrollBarVisibility)}"
                                                   ScrollViewer.VerticalScrollBarVisibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Path=(ScrollViewer.VerticalScrollBarVisibility)}">
                            <local:FlatTreeListControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type prop:PropertyEditTarget}">
                                    <!-- PART_PropertyRow and PART_PropertyRowLabel are how the label splitter finds a row's
                                         label boundary. The transparent background makes the whole row hit testable, gaps
                                         included, so the row under the pointer is always found. -->
                                    <Grid x:Name="PART_PropertyRow" Margin="3" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <!-- Column 0: label - width managed via LabelWidthAfterIndentConverter -->
                                            <ColumnDefinition SharedSizeGroup="Header">
                                                <ColumnDefinition.Width>
                                                    <MultiBinding Converter="{conv:LabelWidthAfterIndentConverter}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Path="DataContext.IndentWidth"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=local:PropertyGrid}" Path="LabelColumnWidth"/>
                                                    </MultiBinding>
                                                </ColumnDefinition.Width>
                                            </ColumnDefinition>
                                            <!-- Column 1: editor fills the rest -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Column 2: delete button (Auto = hidden when collapsed) -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Label with selection highlight and right-click context menu.
                                             ToolTip shows the property name (or "$Name: $ToolTip") when the
                                             grid's PropertyToolTipPlacement includes the name. -->
                                        <Border x:Name="PART_PropertyRowLabel"
                                                Grid.Column="0" Margin="0,0,3,0"
                                                ToolTip="{Binding EffectiveToolTip}"
                                                ToolTipService.IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=local:PropertyGrid}, Path=PropertyToolTipPlacement, Converter={conv:PropertyToolTipPlacementToBoolConverter}, ConverterParameter=Name}">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{Binding RelativeSource={RelativeSource AncestorType=local:FlatTreeListControl}, Path=SelectionBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Set to default"
                                                              Command="{x:Static local:PropertyGrid.SetPropertyToDefaultCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <!-- Label content: switches template based on IsAtDefaultValue. -->
                                            <ContentPresenter Content="{Binding}">
                                                <ContentPresenter.Style>
                                                    <Style TargetType="{x:Type ContentPresenter}">
                                                        <Setter Property="ContentTemplate"
                                                                Value="{Binding RelativeSource={RelativeSource AncestorType=local:PropertyGrid}, Path=ModifiedValueLabelDataTemplate}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAtDefaultValue}" Value="True">
                                                                <Setter Property="ContentTemplate"
                                                                        Value="{Binding RelativeSource={RelativeSource AncestorType=local:PropertyGrid}, Path=DefaultValueLabelDataTemplate}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsExpandable}" Value="True">
                                                                <Setter Property="ContentTemplate"
                                                                        Value="{Binding RelativeSource={RelativeSource AncestorType=local:PropertyGrid}, Path=DefaultValueLabelDataTemplate}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentPresenter.Style>
                                            </ContentPresenter>
                                        </Border>

                                        <!-- Editor: uses EffectiveEditorTarget so elevation is transparent.
                                             Hidden when the row is expandable with no inline editor. -->
                                        <ContentPresenter Grid.Column="1"
                                                          VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Path=VerticalContentAlignment}"
                                                          HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Path=HorizontalContentAlignment}"
                                                          ContentTemplateSelector="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}, Path=ItemTemplateSelector}"
                                                          Content="{Binding EffectiveEditorTarget}"
                                                          ToolTip="{Binding EffectiveToolTip}"
                                                          ToolTipService.IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=local:PropertyGrid}, Path=PropertyToolTipPlacement, Converter={conv:PropertyToolTipPlacementToBoolConverter}, ConverterParameter=Value}">
                                            <ContentPresenter.Style>
                                                <Style TargetType="{x:Type ContentPresenter}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasInlineEditor}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentPresenter.Style>
                                        </ContentPresenter>

                                        <!-- List element header: fills the value column for an expandable element row
                                             (which has no inline editor) with the [PGList] ElementDisplayMemberName value.
                                             IsListElementHeaderVisible already gates on there being no inline editor, so
                                             this never collides with the editor above. -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ListElementHeaderText}"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"
                                                   Opacity="0.85"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsListElementHeaderVisible, Converter={conv:BooleanToVisibilityConverter TrueValue=Visible, FalseValue=Collapsed}}"/>

                                        <!-- Delete button for list elements. Only visible when CanRemoveFromList, and never while the grid is read-only (Edit.IsReadOnly, inherited).
                                             The wrapper carries the visibility style, so the button keeps the implicit Button style and with it the theme's look. -->
                                        <Grid Grid.Column="2">
                                            <Grid.Style>
                                                <Style TargetType="{x:Type Grid}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRemoveFromList}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ap:Edit.IsReadOnly)}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Button VerticalAlignment="Center"
                                                    Padding="4,2"
                                                    MinWidth="20"
                                                    MinHeight="20"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Content="&#xE711;"
                                                    FontSize="9"
                                                    Opacity="0.7"
                                                    Margin="4,0,0,0"
                                                    ToolTip="Remove element"
                                                    Command="{Binding ListElementRemoveCommand}"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </local:FlatTreeListControl.ItemTemplate>
                        </local:FlatTreeListControl>

                        <!-- Label splitter: at the label and editor boundary while the pointer is near it, placed and
                             shown in code. Its hit area is 10 wide, PropertyGridRowRules.kLabelSplitterHitDistance into
                             the label with the line along its right edge, and sits over the rows so a press there drags.
                             Nothing on the editor side, which takes its own clicks. Drag to size the label column,
                             double-click to fit it. -->
                        <Border x:Name="PART_LabelSplitter"
                                Width="10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Cursor="SizeWE"
                                Visibility="Collapsed">
                            <Rectangle Width="2"
                                       HorizontalAlignment="Right"
                                       Fill="{TemplateBinding LabelSplitterBrush}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
