<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ajut="clr-namespace:AJut.UX"
                    xmlns:ap="clr-namespace:AJut.UX.AttachedProperties"
                    xmlns:local="clr-namespace:AJut.UX.Controls"
                    xmlns:conv="clr-namespace:AJut.UX.Converters">

    <!-- Shared item button visuals. All bindings are DataContext (ToggleItem) based - not
         RelativeSource AncestorType ToggleStrip - so the same template works inside the overflow
         Popup, which lives in a separate visual tree that FindAncestor cannot cross. -->
    <ControlTemplate x:Key="ToggleStripItemButtonTemplate" TargetType="{x:Type ToggleButton}">
        <!-- The corner and separator converters take the ToggleItem itself and read its Edges (set by the items panel
             from the shared ToggleStripItemEdges); the Edges binding in each MultiBinding is there so it runs again
             when they change. -->
        <Border x:Name="RootBorder" Background="#01000000">
            <Border.CornerRadius>
                <MultiBinding Converter="{local:ToggleStripCornerRadiusConverter ReductionPercent=0.25}">
                    <Binding/>
                    <Binding Path="Edges"/>
                </MultiBinding>
            </Border.CornerRadius>
            <Border x:Name="InnerBorder" Background="#01000000"
                    BorderBrush="{Binding Path=Owner.SeparatorBrush, Mode=OneWay}">
                <Border.CornerRadius>
                    <MultiBinding Converter="{local:ToggleStripCornerRadiusConverter ReductionPercent=0.3}">
                        <Binding/>
                        <Binding Path="Edges"/>
                    </MultiBinding>
                </Border.CornerRadius>
                <Border.BorderThickness>
                    <MultiBinding Converter="{local:ToggleStripBorderThicknessConverter}">
                        <Binding/>
                        <Binding Path="Edges"/>
                    </MultiBinding>
                </Border.BorderThickness>
                <Grid Margin="{Binding Path=Owner.ItemPadding}">
                    <!-- A ContentPresenter overrides its own DataContext to its Content (the item Data),
                         so its ItemTemplate/Visibility bindings must go through the TemplatedParent
                         (the ToggleButton, whose DataContext is the ToggleItem) rather than the
                         local DataContext - otherwise they bind against the raw data and fail. -->
                    <ContentPresenter Content="{Binding Data}"
                                      ContentTemplate="{Binding Path=DataContext.Owner.ItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                      Visibility="{Binding Path=DataContext.Owner.ItemTemplate, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:NullnessToVisibilityConverter}}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding Path=Owner.ItemTemplate, Converter={conv:NullnessToVisibilityConverter WhenNull=Visible, WhenNotNull=Collapsed}}"/>
                </Grid>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <!-- ======[ Item Pressed ]====== -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="RootBorder" Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.00" Color="{Binding Path=Owner.SeparatorBrush, Converter={conv:BrushColorExtractionConverter}, Mode=OneWay, FallbackValue='#2BA2D8', TargetNullValue='#2BA2D8'}" />
                            <GradientStop Offset="0.20" Color="{Binding Path=Owner.BackgroundPressedColorBase, Converter={local:ToggleStripItemPressedBackgroundColorAlphatizer}, Mode=OneWay, FallbackValue='#2BA2D8', TargetNullValue='#2BA2D8'}" />
                            <GradientStop Offset="1.00" Color="{Binding Path=Owner.BackgroundPressedColorBase, Converter={local:ToggleStripItemPressedBackgroundColorAlphatizer}, Mode=OneWay, FallbackValue='#2BA2D8', TargetNullValue='#2BA2D8'}" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="TextElement.Foreground" Value="{Binding Path=Owner.ForegroundPressed}"/>
            </Trigger>
            <!-- ======[ Item Hover ]====== -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.Foreground" Value="{Binding Path=Owner.ForegroundHover}"/>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding Path=IsSelected}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter TargetName="InnerBorder" Property="Background" Value="{Binding Path=Owner.BackgroundHoverOverPressed}"/>
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding Path=IsSelected}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter TargetName="InnerBorder" Property="Background" Value="{Binding Path=Owner.BackgroundHover}"/>
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Strip row item: every item is realized; the panel arranges overflowed ones to a zero rect. -->
    <DataTemplate x:Key="ToggleStripStripItemTemplate">
        <ToggleButton IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
                      Template="{StaticResource ToggleStripItemButtonTemplate}"/>
    </DataTemplate>

    <!-- Overflow popup item: only the items currently in overflow are visible. -->
    <DataTemplate x:Key="ToggleStripOverflowItemTemplate">
        <ToggleButton IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
                      Template="{StaticResource ToggleStripItemButtonTemplate}"
                      Visibility="{Binding Path=IsInOverflow, Converter={conv:BooleanToVisibilityConverter}}"/>
    </DataTemplate>

    <Style TargetType="{x:Type local:ToggleStrip}">
        <Setter Property="SeparatorBrush" Value="#08080D"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="OverflowPopupBackground" Value="#CCC"/>
        <Setter Property="OverflowPopupBorderBrush" Value="#222"/>
        <Setter Property="BackgroundPressedColorBase" Value="#2BA2D8"/>
        <Setter Property="BackgroundHover">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                    <GradientStop Offset="0.00" Color="#1E8BB5" />
                    <GradientStop Offset="0.10" Color="#1EA1D0" />
                    <GradientStop Offset="0.90" Color="#2BA2D8" />
                    <GradientStop Offset="1.00" Color="#1E8BB5" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundHoverOverPressed" Value="{Binding RelativeSource={RelativeSource Self}, Path=BackgroundHover}"/>
        <Setter Property="ForegroundPressed" Value="{Binding RelativeSource={RelativeSource Self}, Path=Foreground}"/>
        <Setter Property="ForegroundHover" Value="{Binding RelativeSource={RelativeSource Self}, Path=Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToggleStrip}">
                    <Border x:Name="StripBorder"
                            Background="{ajut:TemplateBinding Background}"
                            BorderBrush="{ajut:TemplateBinding BorderBrush}"
                            BorderThickness="{ajut:TemplateBinding BorderThickness}"
                            CornerRadius="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=(ap:BorderXTA.CornerRadius)}"
                            HorizontalAlignment="{ajut:TemplateBinding HorizontalContentAlignment}"
                            SnapsToDevicePixels="True">
                        <!-- Single overlay cell: the ScrollViewer hosts the items and clips (Clip/OverflowPopup)
                             or scrolls (Scroll); the overflow chevron and the two Scroll-mode bump buttons are
                             drawn on top at the edges so they never consume layout length. The bump buttons'
                             scrollbar visibility, show/hide, enable, clearance and scroll are driven from code.
                             Each button's glyph is its Tag, so the Orientation trigger below can swap it. -->
                        <Grid>
                            <ScrollViewer x:Name="PART_ScrollHost"
                                          Focusable="False"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PART_ItemsHost"
                                              ItemsSource="{ajut:TemplateBinding Items}"
                                              ItemTemplate="{StaticResource ToggleStripStripItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:ToggleStripPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Overflow chevron: shown only when items overflow; opens the popup. -->
                            <ToggleButton x:Name="PART_OverflowToggle"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Stretch"
                                          Width="28"
                                          Tag="&#xE76C;"
                                          Focusable="False"
                                          Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=HasOverflow, Converter={conv:BooleanToVisibilityConverter}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <!-- No divider of its own: the last item showing draws the separator before the chevron. -->
                                        <Border Background="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=Background}">
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup PlacementTarget="{Binding ElementName=PART_OverflowToggle}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding ElementName=PART_OverflowToggle, Path=IsChecked, Mode=TwoWay}"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <Border Background="{ajut:TemplateBinding OverflowPopupBackground}"
                                        BorderBrush="{ajut:TemplateBinding OverflowPopupBorderBrush}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ItemsControl ItemsSource="{ajut:TemplateBinding Items}"
                                                  ItemTemplate="{StaticResource ToggleStripOverflowItemTemplate}"/>
                                </Border>
                            </Popup>

                            <!-- Scroll-mode bump buttons: overlaid chevrons. Code shows them only in Scroll
                                 mode when there is something to scroll, enables them per end, and scrolls. -->
                            <RepeatButton x:Name="PART_ScrollLeftButton"
                                          HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                          Width="24" Tag="&#xE76B;" Focusable="False" Visibility="Collapsed">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                        <Border Background="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=Background}">
                                            <TextBlock x:Name="Chevron" Opacity="0.55"
                                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chevron" Property="Opacity" Value="0.25"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                            <RepeatButton x:Name="PART_ScrollRightButton"
                                          HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                          Width="24" Tag="&#xE76C;" Focusable="False" Visibility="Collapsed">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                        <Border Background="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=Background}">
                                            <TextBlock x:Name="Chevron" Opacity="0.55"
                                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chevron" Property="Opacity" Value="0.25"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Vertical: the strip sizes its height from VerticalContentAlignment (as it sizes its
                             width from HorizontalContentAlignment), the overflow chevron runs along the bottom
                             edge pointing down, and the bump buttons sit on the top and bottom edges. -->
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="StripBorder" Property="VerticalAlignment" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalContentAlignment}"/>
                            <Setter TargetName="PART_OverflowToggle" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_OverflowToggle" Property="VerticalAlignment" Value="Bottom"/>
                            <Setter TargetName="PART_OverflowToggle" Property="Width" Value="NaN"/>
                            <Setter TargetName="PART_OverflowToggle" Property="Height" Value="28"/>
                            <Setter TargetName="PART_OverflowToggle" Property="Tag" Value="&#xE70D;"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="VerticalAlignment" Value="Top"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Width" Value="NaN"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Height" Value="24"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Tag" Value="&#xE70E;"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="VerticalAlignment" Value="Bottom"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Width" Value="NaN"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Height" Value="24"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Tag" Value="&#xE70D;"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
