<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ajut="clr-namespace:AJut.UX"
                    xmlns:ap="clr-namespace:AJut.UX.AttachedProperties"
                    xmlns:local="clr-namespace:AJut.UX.Controls"
                    xmlns:conv="clr-namespace:AJut.UX.Converters">

    <!-- Shared item button visuals. All bindings are DataContext (ToggleItem) based - not
         RelativeSource AncestorType ToggleStrip - so the same template works inside the overflow
         Popup, which lives in a separate visual tree that FindAncestor cannot cross. -->
    <ControlTemplate x:Key="ToggleStripItemButtonTemplate" TargetType="{x:Type ToggleButton}">
        <!-- The corner and separator converters take the ToggleItem itself and read its Edges (set by the items panel
             from the shared ToggleStripItemEdges); the Edges binding in each MultiBinding is there so it runs again
             when they change. -->
        <Border x:Name="RootBorder" Background="#01000000">
            <Border.CornerRadius>
                <MultiBinding Converter="{local:ToggleStripCornerRadiusConverter ReductionPercent=0.25}">
                    <Binding/>
                    <Binding Path="Edges"/>
                </MultiBinding>
            </Border.CornerRadius>
            <Border x:Name="InnerBorder" Background="#01000000"
                    BorderBrush="{Binding Path=Owner.SeparatorBrush, Mode=OneWay}">
                <Border.CornerRadius>
                    <MultiBinding Converter="{local:ToggleStripCornerRadiusConverter ReductionPercent=0.3}">
                        <Binding/>
                        <Binding Path="Edges"/>
                    </MultiBinding>
                </Border.CornerRadius>
                <Border.BorderThickness>
                    <MultiBinding Converter="{local:ToggleStripBorderThicknessConverter}">
                        <Binding/>
                        <Binding Path="Edges"/>
                    </MultiBinding>
                </Border.BorderThickness>
                <Grid Margin="{Binding Path=Owner.ItemPadding}">
                    <!-- A ContentPresenter overrides its own DataContext to its Content (the item Data),
                         so its ItemTemplate/Visibility bindings must go through the TemplatedParent
                         (the ToggleButton, whose DataContext is the ToggleItem) rather than the
                         local DataContext - otherwise they bind against the raw data and fail. -->
                    <ContentPresenter Content="{Binding Data}"
                                      ContentTemplate="{Binding Path=DataContext.Owner.ItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                      Visibility="{Binding Path=DataContext.Owner.ItemTemplate, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:NullnessToVisibilityConverter}}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding Path=Owner.ItemTemplate, Converter={conv:NullnessToVisibilityConverter WhenNull=Visible, WhenNotNull=Collapsed}}"/>
                </Grid>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <!-- ======[ Item Pressed ]====== -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="RootBorder" Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.00" Color="{Binding Path=Owner.SeparatorBrush, Converter={conv:BrushColorExtractionConverter}, Mode=OneWay, FallbackValue='#2BA2D8', TargetNullValue='#2BA2D8'}" />
                            <GradientStop Offset="0.20" Color="{Binding Path=Owner.BackgroundPressedColorBase, Converter={local:ToggleStripItemPressedBackgroundColorAlphatizer}, Mode=OneWay, FallbackValue='#2BA2D8', TargetNullValue='#2BA2D8'}" />
                            <GradientStop Offset="1.00" Color="{Binding Path=Owner.BackgroundPressedColorBase, Converter={local:ToggleStripItemPressedBackgroundColorAlphatizer}, Mode=OneWay, FallbackValue='#2BA2D8', TargetNullValue='#2BA2D8'}" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="TextElement.Foreground" Value="{Binding Path=Owner.ForegroundPressed}"/>
            </Trigger>
            <!-- ======[ Item Hover ]====== -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextElement.Foreground" Value="{Binding Path=Owner.ForegroundHover}"/>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding Path=IsSelected}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter TargetName="InnerBorder" Property="Background" Value="{Binding Path=Owner.BackgroundHoverOverPressed}"/>
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding Path=IsSelected}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter TargetName="InnerBorder" Property="Background" Value="{Binding Path=Owner.BackgroundHover}"/>
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
            <!-- ======[ Strip Disabled ]====== -->
            <!-- Last, so it wins over the selected item's text. The selected item's fill goes muted, so the selection still shows, and the
                 lines between items take the strip's disabled border, as its frame does. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="TextElement.Foreground" Value="{Binding Path=Owner.DisabledForeground}"/>
                <Setter TargetName="InnerBorder" Property="BorderBrush" Value="{Binding Path=Owner.DisabledBorderBrush}"/>
            </Trigger>
            <!-- The selection stays, muted, so it still shows without reading as live -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsEnabled" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="RootBorder" Property="Background" Value="{Binding Path=Owner.DisabledSelectedBackground}"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The item buttons take this style rather than any implicit ToggleButton style an app or theme defines. A style's
         triggers outrank a template's, so an implicit style's checked and hover text colors would replace the strip's own
         ForegroundPressed and ForegroundHover, which the template's triggers above apply. -->
    <Style x:Key="ToggleStripItemButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{Binding Path=Owner.Foreground}"/>
        <Setter Property="FocusVisualStyle" Value="{Binding Path=Owner.FocusVisualStyle}"/>
        <Setter Property="Template" Value="{StaticResource ToggleStripItemButtonTemplate}"/>
    </Style>

    <!-- Strip row item: every item is realized; the panel arranges overflowed ones to a zero rect. -->
    <DataTemplate x:Key="ToggleStripStripItemTemplate">
        <ToggleButton IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
                      Style="{StaticResource ToggleStripItemButtonStyle}"/>
    </DataTemplate>

    <!-- Overflow popup item: only the items currently in overflow are visible. -->
    <DataTemplate x:Key="ToggleStripOverflowItemTemplate">
        <ToggleButton IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
                      Style="{StaticResource ToggleStripItemButtonStyle}"
                      Visibility="{Binding Path=IsInOverflow, Converter={conv:BooleanToVisibilityConverter}}"/>
    </DataTemplate>

    <Style TargetType="{x:Type local:ToggleStrip}">
        <Setter Property="SeparatorBrush" Value="#08080D"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="OverflowPopupBackground" Value="#CCC"/>
        <Setter Property="OverflowPopupBorderBrush" Value="#222"/>
        <Setter Property="BackgroundPressedColorBase" Value="#2BA2D8"/>
        <Setter Property="BackgroundHover">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                    <GradientStop Offset="0.00" Color="#1E8BB5" />
                    <GradientStop Offset="0.10" Color="#1EA1D0" />
                    <GradientStop Offset="0.90" Color="#2BA2D8" />
                    <GradientStop Offset="1.00" Color="#1E8BB5" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundHoverOverPressed" Value="{Binding RelativeSource={RelativeSource Self}, Path=BackgroundHover}"/>
        <Setter Property="ForegroundPressed" Value="{Binding RelativeSource={RelativeSource Self}, Path=Foreground}"/>
        <Setter Property="ForegroundHover" Value="{Binding RelativeSource={RelativeSource Self}, Path=Foreground}"/>
        <!-- Disabled, as a stock disabled ComboBox: a flat light fill, a light border and gray text -->
        <Setter Property="DisabledBackground" Value="#F0F0F0"/>
        <Setter Property="DisabledBorderBrush" Value="#D9D9D9"/>
        <Setter Property="DisabledForeground" Value="#6D6D6D"/>
        <Setter Property="DisabledSelectedBackground" Value="#C4CFD9"/>
        <!-- Vertical, the scroll and overflow buttons are plain buttons: WPF's own button colors -->
        <Setter Property="VerticalButtonBackground" Value="#DDDDDD"/>
        <Setter Property="VerticalButtonForeground" Value="#000000"/>
        <Setter Property="VerticalButtonBorderBrush" Value="#707070"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToggleStrip}">
                    <Border x:Name="StripBorder"
                            Background="{ajut:TemplateBinding Background}"
                            BorderBrush="{ajut:TemplateBinding BorderBrush}"
                            BorderThickness="{ajut:TemplateBinding BorderThickness}"
                            CornerRadius="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=(ap:BorderXTA.CornerRadius)}"
                            HorizontalAlignment="{ajut:TemplateBinding HorizontalContentAlignment}"
                            SnapsToDevicePixels="True">
                        <!-- Single overlay cell: the ScrollViewer hosts the items and clips (Clip/OverflowPopup)
                             or scrolls (Scroll); the overflow chevron and the two Scroll-mode bump buttons are
                             drawn on top at the edges so they never consume layout length. The bump buttons'
                             scrollbar visibility, show/hide, enable, clearance and scroll are driven from code.
                             Each button's glyph is its Tag, so the Orientation trigger below can swap it. -->
                        <Grid>
                            <ScrollViewer x:Name="PART_ScrollHost"
                                          Focusable="False"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PART_ItemsHost"
                                              ItemsSource="{ajut:TemplateBinding Items}"
                                              ItemTemplate="{StaticResource ToggleStripStripItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:ToggleStripPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Overflow chevron: shown only when items overflow; opens the popup. It and the bump buttons
                                 below sit on the strip, so they take its Background and Foreground here, where the
                                 strip's disabled trigger can swap them along with its frame. -->
                            <ToggleButton x:Name="PART_OverflowToggle"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Stretch"
                                          Width="28"
                                          Tag="&#xE76C;"
                                          Focusable="False"
                                          Background="{ajut:TemplateBinding Background}"
                                          Foreground="{ajut:TemplateBinding Foreground}"
                                          BorderThickness="0"
                                          Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:ToggleStrip}, Path=HasOverflow, Converter={conv:BooleanToVisibilityConverter}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <!-- No divider of its own: the last item showing draws the separator before the chevron. -->
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup PlacementTarget="{Binding ElementName=PART_OverflowToggle}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding ElementName=PART_OverflowToggle, Path=IsChecked, Mode=TwoWay}"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <Border Background="{ajut:TemplateBinding OverflowPopupBackground}"
                                        BorderBrush="{ajut:TemplateBinding OverflowPopupBorderBrush}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ItemsControl ItemsSource="{ajut:TemplateBinding Items}"
                                                  ItemTemplate="{StaticResource ToggleStripOverflowItemTemplate}"/>
                                </Border>
                            </Popup>

                            <!-- Scroll-mode bump buttons: overlaid chevrons. Code shows them only in Scroll
                                 mode when there is something to scroll, enables them per end, and scrolls. -->
                            <RepeatButton x:Name="PART_ScrollLeftButton" Style="{x:Null}" BorderThickness="0"
                                          HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                          Width="24" Tag="&#xE76B;" Focusable="False" Visibility="Collapsed"
                                          Background="{ajut:TemplateBinding Background}" Foreground="{ajut:TemplateBinding Foreground}">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <TextBlock x:Name="Chevron" Opacity="0.55"
                                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chevron" Property="Opacity" Value="0.25"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                            <RepeatButton x:Name="PART_ScrollRightButton" Style="{x:Null}" BorderThickness="0"
                                          HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                          Width="24" Tag="&#xE76C;" Focusable="False" Visibility="Collapsed"
                                          Background="{ajut:TemplateBinding Background}" Foreground="{ajut:TemplateBinding Foreground}">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <TextBlock x:Name="Chevron" Opacity="0.55"
                                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chevron" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chevron" Property="Opacity" Value="0.25"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Vertical: the strip sizes its height from VerticalContentAlignment (as it sizes its
                             width from HorizontalContentAlignment), the overflow chevron runs along the bottom
                             edge pointing down, and the bump buttons sit on the top and bottom edges. -->
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="StripBorder" Property="VerticalAlignment" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalContentAlignment}"/>
                            <Setter TargetName="PART_OverflowToggle" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_OverflowToggle" Property="VerticalAlignment" Value="Bottom"/>
                            <Setter TargetName="PART_OverflowToggle" Property="Width" Value="NaN"/>
                            <Setter TargetName="PART_OverflowToggle" Property="Height" Value="28"/>
                            <Setter TargetName="PART_OverflowToggle" Property="Tag" Value="&#xE70D;"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="VerticalAlignment" Value="Top"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Width" Value="NaN"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Height" Value="24"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Tag" Value="&#xE70E;"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="VerticalAlignment" Value="Bottom"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Width" Value="NaN"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Height" Value="24"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Tag" Value="&#xE70D;"/>
                            <!-- The surface shades top to bottom, so across a vertical strip's ends these would show a slice of
                                 it that reads as part of neither; they take plain button colors instead -->
                            <Setter TargetName="PART_OverflowToggle" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalButtonBackground}"/>
                            <Setter TargetName="PART_OverflowToggle" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalButtonForeground}"/>
                            <Setter TargetName="PART_OverflowToggle" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalButtonBorderBrush}"/>
                            <Setter TargetName="PART_OverflowToggle" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalButtonBackground}"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalButtonForeground}"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalButtonBorderBrush}"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalButtonBackground}"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalButtonForeground}"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VerticalButtonBorderBrush}"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <!-- Disabled: the strip's Disabled brushes on its frame and on the buttons that sit on it. Set
                             here on the template's own parts so they win over a Background set on the strip itself. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="StripBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledBackground}"/>
                            <Setter TargetName="StripBorder" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledBorderBrush}"/>
                            <Setter TargetName="PART_OverflowToggle" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledBackground}"/>
                            <Setter TargetName="PART_OverflowToggle" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledForeground}"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledBackground}"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledForeground}"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledBackground}"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledForeground}"/>
                            <!-- Only a vertical strip's buttons draw a border, and disabled it is the strip's disabled one -->
                            <Setter TargetName="PART_OverflowToggle" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledBorderBrush}"/>
                            <Setter TargetName="PART_ScrollLeftButton" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledBorderBrush}"/>
                            <Setter TargetName="PART_ScrollRightButton" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisabledBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
