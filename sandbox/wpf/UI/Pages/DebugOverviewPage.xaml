<UserControl x:Class="TheAJutShowRoom.UI.Pages.DebugOverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TheAJutShowRoom.UI.Pages"
             xmlns:debug="clr-namespace:TheAJutShowRoom.UI.Controls.Diagnostics"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Self">
    <TabControl TabStripPlacement="Left">
        <TabItem Header="Theme state">
            <debug:ThemeStateDisplay />
        </TabItem>
        <TabItem Header="Standard controls">
            <debug:StandardControlsDisplay />
        </TabItem>
    </TabControl>
</UserControl>
