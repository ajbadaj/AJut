<UserControl x:Class="TheAJutShowRoom.UI.Pages.UxStrategiesOverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TheAJutShowRoom.UI.Pages"
             xmlns:strategies="clr-namespace:TheAJutShowRoom.UI.Controls.Strategies"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Self">
    <TabControl TabStripPlacement="Left">
        <TabItem Header="Undo and Redo">
            <strategies:UndoRedoStrategyExample />
        </TabItem>
        <TabItem Header="Settings as JSON">
            <strategies:SettingsAsJsonStrategyExample />
        </TabItem>
        <TabItem Header="Layered Overrides with Stratabase">
            <strategies:StratabaseOverridesStrategyExample />
        </TabItem>
        <TabItem Header="Edit Any Object">
            <strategies:EditAnyObjectStrategyExample />
        </TabItem>
    </TabControl>
</UserControl>
