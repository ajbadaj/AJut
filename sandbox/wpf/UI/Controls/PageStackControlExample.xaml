<UserControl x:Class="TheAJutShowRoom.UI.Controls.PageStackControlExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ajut="clr-namespace:AJut.UX.Controls;assembly=AJut.UX.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="PageStackExample_Style_Page" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="BumpStack's sibling for paging: one page shows at a time, and the neighbor pages peek in, faded, past the page buttons. A click on a page button or a dot runs an animated transition. With the stack focused, the arrow keys, Home and End page too. The dot strip shows DotReach dots each side of the current page, plus a smaller, faded edge dot while there are more pages past them; clicking an edge dot goes just past the window."/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="ShowDotsCheck" Content="ShowDots (every stack below)" IsChecked="True" Margin="0,0,16,0"/>
            <CheckBox x:Name="ShowPageCountCheck" Content="ShowPageCount (every stack below)" IsChecked="True"/>
        </StackPanel>

        <TextBlock Text="Horizontal, 12 pages, DotReach=2" FontWeight="Bold"/>
        <ajut:PageStack x:Name="PageStackHorizontal" Width="420" Height="180" HorizontalAlignment="Left"
                        DotReach="2" BorderBrush="#80808080" BorderThickness="1"
                        ShowDots="{Binding ElementName=ShowDotsCheck, Path=IsChecked}"
                        ShowPageCount="{Binding ElementName=ShowPageCountCheck, Path=IsChecked}">
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#884690C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 1" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#886B90C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 2" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#889090C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 3" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#88B590C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 4" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#88DA90C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 5" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#886990C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 6" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#888E90C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 7" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#88B390C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 8" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#88D890C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 9" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#886790C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 10" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#888C90C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 11" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#88B190C8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Page 12" FontSize="18" HorizontalAlignment="Center"/>
                    <Button Content="A button on the page" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </ajut:PageStack>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
            <TextBlock Text="SelectedIndex: "/>
            <TextBlock Text="{Binding ElementName=PageStackHorizontal, Path=SelectedIndex}"/>
        </StackPanel>

        <TextBlock Text="Vertical, 5 pages, a slower TransitionDuration" FontWeight="Bold"/>
        <ajut:PageStack Orientation="Vertical" Width="260" Height="240" HorizontalAlignment="Left" Margin="0,0,0,10"
                        TransitionDuration="0:0:0.6" BorderBrush="#80808080" BorderThickness="1"
                        ShowDots="{Binding ElementName=ShowDotsCheck, Path=IsChecked}"
                        ShowPageCount="{Binding ElementName=ShowPageCountCheck, Path=IsChecked}">
                <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#884690C8">
                    <TextBlock Text="Card 1" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#886B90C8">
                    <TextBlock Text="Card 2" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#889090C8">
                    <TextBlock Text="Card 3" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#88B590C8">
                    <TextBlock Text="Card 4" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#88DA90C8">
                    <TextBlock Text="Card 5" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
        </ajut:PageStack>

        <TextBlock Text="Three pages, starting on the last (SelectedIndex=2 set before the pages are added)" FontWeight="Bold"/>
        <ajut:PageStack Width="420" Height="120" HorizontalAlignment="Left" SelectedIndex="2" BorderBrush="#80808080" BorderThickness="1"
                        ShowDots="{Binding ElementName=ShowDotsCheck, Path=IsChecked}"
                        ShowPageCount="{Binding ElementName=ShowPageCountCheck, Path=IsChecked}">
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#884690C8">
                <TextBlock Text="First" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#886B90C8">
                <TextBlock Text="Second" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Style="{StaticResource PageStackExample_Style_Page}" Background="#889090C8">
                <TextBlock Text="Third" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ajut:PageStack>
    </StackPanel>
</UserControl>
