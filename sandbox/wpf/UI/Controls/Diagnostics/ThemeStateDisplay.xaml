<UserControl x:Class="TheAJutShowRoom.UI.Controls.Diagnostics.ThemeStateDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TheAJutShowRoom.UI.Controls.Diagnostics"
             xmlns:app="clr-namespace:TheAJutShowRoom"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Self">
    <StackPanel Margin="20">
        <TextBlock Text="Theme state" FontSize="18"/>
        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,5,0,10"
                   Text="What the showroom's theme machinery currently holds. The theme switches in the drawer change these live; the AJut versions come from the loaded assemblies."/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Use themes:" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="Consolas" Text="{Binding Source={x:Static app:App.Current}, Path=UseThemes, Mode=OneWay}"/>
            <TextBlock Grid.Row="1" Text="Theme configuration:" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Text="{Binding Source={x:Static app:App.ThemeTracker}, Path=ThemeConfiguration, Mode=OneWay}"/>
            <TextBlock Grid.Row="2" Text="Resolved theme:" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas" Text="{Binding Source={x:Static app:App.ThemeTracker}, Path=CurrentTheme, Mode=OneWay}"/>
            <TextBlock Grid.Row="3" Text="AJut.Core version:" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="3" Grid.Column="1" FontFamily="Consolas" Text="{Binding Source={x:Static app:App.AJut_Core_Version}, Mode=OneWay}"/>
            <TextBlock Grid.Row="4" Text="AJut.UX.Wpf version:" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="4" Grid.Column="1" FontFamily="Consolas" Text="{Binding Source={x:Static app:App.AJut_Ux_Wpf_Version}, Mode=OneWay}"/>
        </Grid>
        <TextBlock Text="Brush check" FontSize="16" Margin="0,20,0,5"/>
        <TextBlock TextWrapping="WrapWithOverflow" Margin="0,0,0,5" Text="A few of the AJut palette brushes as resolved right now. If a swatch is blank, that brush is not defined by the loaded theme."/>
        <WrapPanel>
            <Border Width="120" Height="40" Margin="0,0,5,5" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource AJut_Brush_PrimaryHighlightDesat}" ToolTip="AJut_Brush_PrimaryHighlightDesat">
                <TextBlock Text="PrimaryHighlightDesat" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="120" Height="40" Margin="0,0,5,5" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource AJut_Brush_PopupBackground}" ToolTip="AJut_Brush_PopupBackground">
                <TextBlock Text="PopupBackground" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="120" Height="40" Margin="0,0,5,5" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource AJut_Brush_GroupBorder}" ToolTip="AJut_Brush_GroupBorder">
                <TextBlock Text="GroupBorder" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="120" Height="40" Margin="0,0,5,5" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource AJut_Brush_BannerBackground}" ToolTip="AJut_Brush_BannerBackground">
                <TextBlock Text="BannerBackground" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Width="120" Height="40" Margin="0,0,5,5" BorderBrush="Black" BorderThickness="1" Background="{DynamicResource AJut_Brush_ImportantText}" ToolTip="AJut_Brush_ImportantText">
                <TextBlock Text="ImportantText" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </WrapPanel>
    </StackPanel>
</UserControl>
