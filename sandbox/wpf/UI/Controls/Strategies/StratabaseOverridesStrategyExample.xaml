<UserControl x:Class="TheAJutShowRoom.UI.Controls.Strategies.StratabaseOverridesStrategyExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TheAJutShowRoom.UI.Controls.Strategies"
             xmlns:ctrls="clr-namespace:TheAJutShowRoom.UI.Controls"
             xmlns:ajut="clr-namespace:AJut.UX.Controls;assembly=AJut.UX.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Self">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Maybe you want layered overrides" FontSize="18"/>
            <TextBlock TextWrapping="WrapWithOverflow" Margin="0,5,0,10">
                <TextBlock.Inlines>
                    <Run Text="A default, a per-project override, a per-user override, and whichever is set highest wins. Here it is, built with"/>
                    <Run Text="AJut.Storage.Stratabase." FontFamily="Consolas" FontWeight="Bold"/>
                    <Run Text="A Stratabase is a baseline layer plus a fixed number of override layers, each holding named property values for objects identified by Guid. GeneratePropertyAccess hands back a typed accessor for one property of one object: GetValue resolves top-down through the layers, ActiveLayerIndex says which layer won (-1 is the baseline), and ValueChanged fires when the resolved value moves for any reason. This demo has one object, one property, and two override layers."/>
                </TextBlock.Inlines>
            </TextBlock>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <GroupBox Header="Baseline (layer -1)">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Set baseline" Padding="10,2" Margin="5,0,0,0" Click="SetBaseline_OnClick"/>
                        <TextBox x:Name="BaselineInput" Text="Default title"/>
                    </DockPanel>
                </GroupBox>
                <GroupBox Header="Project override (layer 0)" Margin="0,8,0,0">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" x:Name="ProjectOverrideActive" Content="Active" VerticalAlignment="Center" Margin="5,0,0,0"
                                  Checked="ProjectOverride_OnCheckedChanged" Unchecked="ProjectOverride_OnCheckedChanged"/>
                        <TextBox x:Name="ProjectOverrideInput" Text="Project title" TextChanged="ProjectOverrideInput_OnTextChanged"/>
                    </DockPanel>
                </GroupBox>
                <GroupBox Header="User override (layer 1)" Margin="0,8,0,0">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" x:Name="UserOverrideActive" Content="Active" VerticalAlignment="Center" Margin="5,0,0,0"
                                  Checked="UserOverride_OnCheckedChanged" Unchecked="UserOverride_OnCheckedChanged"/>
                        <TextBox x:Name="UserOverrideInput" Text="My title" TextChanged="UserOverrideInput_OnTextChanged"/>
                    </DockPanel>
                </GroupBox>
                <Border Margin="0,12,0,0" Padding="10" BorderThickness="2" BorderBrush="{DynamicResource AJut_Brush_GroupBorder}">
                    <StackPanel>
                        <TextBlock Text="Resolved value" FontWeight="Bold"/>
                        <TextBlock FontSize="20" Text="{Binding ElementName=Self, Path=ResolvedValue, Mode=OneWay}"/>
                        <TextBlock FontStyle="Italic" Text="{Binding ElementName=Self, Path=ResolvedFromText, Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <ctrls:BasicCodeDisplay Grid.Column="2" CodeText="{Binding ElementName=Self, Path=CodeText, Mode=OneWay}"/>
        </Grid>
    </DockPanel>
</UserControl>
