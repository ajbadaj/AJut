<UserControl x:Class="TheAJutShowRoom.UI.Controls.Strategies.EditAnyObjectStrategyExample"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TheAJutShowRoom.UI.Controls.Strategies"
             xmlns:ctrls="clr-namespace:TheAJutShowRoom.UI.Controls"
             xmlns:ajut="clr-namespace:AJut.UX.Controls;assembly=AJut.UX.Wpf"
             xmlns:ajprop="clr-namespace:AJut.UX.PropertyInteraction;assembly=AJut.UX"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Self">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Maybe you want to edit any object" FontSize="18"/>
            <TextBlock TextWrapping="WrapWithOverflow" Margin="0,5,0,10">
                <TextBlock.Inlines>
                    <Run Text="A settings object, a selected item in a tool, a thing loaded from a file: an editor for each one is a lot of XAML that all looks the same. Here it is, built with"/>
                    <Run Text="AJut.UX.Controls.PropertyGrid" FontFamily="Consolas" FontWeight="Bold"/>
                    <Run Text="and the PG attributes in"/>
                    <Run Text="AJut.UX.PropertyInteraction." FontFamily="Consolas" FontWeight="Bold"/>
                    <Run Text="Point the grid at an object and it builds a row per public property. Attributes on the object pick the editor, the label, the group, the tooltip, and can add buttons; the grid's template selector maps editor names to the controls that do the editing. The object below is a plain class with a few attributes, and the grid on the left is the whole editor."/>
                </TextBlock.Inlines>
            </TextBlock>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource AJut_Brush_GroupBorder}">
                    <StackPanel>
                        <TextBlock Text="What the object holds right now" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ElementName=Self, Path=Target.Summary, Mode=OneWay}" TextWrapping="WrapWithOverflow"/>
                    </StackPanel>
                </Border>
                <ajut:PropertyGrid SingleItemSource="{Binding ElementName=Self, Path=Target, Mode=OneWay}"
                                   LabelColumnWidth="150" HorizontalContentAlignment="Stretch"
                                   PropertyToolTipPlacement="PropertyNameAndValue"
                                   BorderThickness="2" BorderBrush="{DynamicResource AJut_Brush_BorderCommon}">
                    <ajut:PropertyGrid.ItemTemplateSelector>
                        <ajut:PropertyGridTemplateSelector>
                            <ajut:PropertyGridTemplateSelector.RegisteredTemplates>
                                <DataTemplate x:Key="Text" DataType="{x:Type ajprop:PropertyEditTarget}">
                                    <ajut:EditableTextBlock Text="{Binding Path=EditValue, Mode=TwoWay}"/>
                                </DataTemplate>
                                <DataTemplate x:Key="Number" DataType="{x:Type ajprop:PropertyEditTarget}">
                                    <ajut:NumericEditor Value="{Binding Path=EditValue, Mode=TwoWay}" NumberTextAlignment="Left"/>
                                </DataTemplate>
                                <DataTemplate x:Key="Toggle" DataType="{x:Type ajprop:PropertyEditTarget}">
                                    <ajut:ToggleSwitchButton IsChecked="{Binding Path=EditValue, Mode=TwoWay}" HorizontalAlignment="Left"/>
                                </DataTemplate>
                                <DataTemplate x:Key="Enum" DataType="{x:Type ajprop:PropertyEditTarget}">
                                    <ajut:EnumComboBox SelectedItem="{Binding Path=EditValue, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ajut:PropertyGridTemplateSelector.RegisteredTemplates>
                            <ajut:PropertyGridTemplateSelector.Default>
                                <DataTemplate DataType="{x:Type ajprop:PropertyEditTarget}">
                                    <TextBlock Text="{Binding Path=EditValue}"/>
                                </DataTemplate>
                            </ajut:PropertyGridTemplateSelector.Default>
                        </ajut:PropertyGridTemplateSelector>
                    </ajut:PropertyGrid.ItemTemplateSelector>
                </ajut:PropertyGrid>
            </DockPanel>
            <ctrls:BasicCodeDisplay Grid.Column="2" CodeText="{Binding ElementName=Self, Path=CodeText, Mode=OneWay}"/>
        </Grid>
    </DockPanel>
</UserControl>
