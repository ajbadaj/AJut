<UserControl x:Class="TheAJutShowRoom.UI.Controls.StackNavDemo.StackNavDemoDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TheAJutShowRoom.UI.Controls.StackNavDemo"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="200">
    <StackPanel Margin="5">
        <TextBlock TextWrapping="WrapWithOverflow" Text="This drawer belongs to page A. A drawer is any object set on adapter.DrawerDisplay."/>
        <Button Content="Push page B" Margin="0,10,0,0" Click="PushPageB_OnClick"/>
        <Button Content="Close drawer" Margin="0,3,0,0" Click="CloseDrawer_OnClick"/>
    </StackPanel>
</UserControl>
