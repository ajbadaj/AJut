<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AJutShowRoomWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ajut_conv="using:AJut.UX.Converters"
    mc:Ignorable="d"
    Title="AJut Showroom for WinUI"
    x:Name="Self">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <!-- The window sits on AJut's own chrome. The border color, the title bar background and the caption button
         highlights are the control's: it turns the border red when the pointer is over the close button, with no
         binding here. The jewel in the title bar is this showroom's own reaction to LastState, kept as the example
         of a consumer following the chrome state. -->
    <ajut:ThemedWindowRootControl x:Name="Root" TargetBorderThickness="2" TitleBarHeight="40" ShowFullscreenButtons="True"
                                  BorderBrush="{ThemeResource AJut_Brush_WindowGlowBorder}"
                                  InactiveTitlebarBackground="{ThemeResource AJut_Brush_TitleBarBackgroundInactive}"
                                  CornerRadius="{Binding ElementName=Root, Path=IsMaximizedOrFullScreened, Converter={ajut_conv:BooleanToCornerRadiusConverter TrueValue='0', FalseValue='5'}}"
                                  BorderThickness="{Binding ElementName=Root, Path=IsMaximizedOrFullScreened, Converter={ajut_conv:BooleanToThicknessConverter TrueValue='0', FalseValue='3'}}">
        <ajut:ThemedWindowRootControl.CustomTilteBar>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Path x:Name="JewelBkgPath" Data="M 0,0 L 40,0 L 60,20 L 40,40 L 0,40 Z" StrokeThickness="0">
                        <Path.Fill>
                            <Binding ElementName="Root" Path="LastState">
                                <Binding.Converter>
                                    <ajut_conv:StringToBrushSwitchConverter>
                                        <ajut_conv:StringToBrushSwitchConverter.Cases>
                                            <ajut_conv:BrushDictionary>
                                                <SolidColorBrush x:Key="CloseHover" Color="{ThemeResource AJut_Color_ChromeCloseButtonComplement}"/>
                                                <SolidColorBrush x:Key="ChromeButtonsHover" Color="{ThemeResource AJut_Color_PrimaryHighlightBright}"/>
                                                <SolidColorBrush x:Key="Normal" Color="{ThemeResource AJut_Color_PrimaryHighlight}"/>
                                                <SolidColorBrush x:Key="Inactive" Color="{ThemeResource AJut_Color_PrimaryHighlightDesat}"/>
                                            </ajut_conv:BrushDictionary>
                                        </ajut_conv:StringToBrushSwitchConverter.Cases>
                                    </ajut_conv:StringToBrushSwitchConverter>
                                </Binding.Converter>
                            </Binding>
                        </Path.Fill>
                    </Path>
                    <Image Source="/Assets/app.ico" Margin="3"/>
                </Grid>
                <Grid x:Name="TitleArea" Grid.Column="1">
                    <TextBlock Text="AJut Showroom: WinUI3" Foreground="{ThemeResource AJut_Brush_ImportantText}" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="18" HorizontalAlignment="Left"/>
                </Grid>
            </Grid>
        </ajut:ThemedWindowRootControl.CustomTilteBar>
        <!-- Content-area inset frame: a 10px left/right/bottom margin while restored that collapses
             to 0 when maximized or fullscreened. That margin is the eyeball half of the window chrome
             probe - it has to vanish on maximize and come back on restore. -->
        <Border BorderBrush="{Binding ElementName=JewelBkgPath, Path=Fill}">
            <Border.BorderThickness>
                <Binding ElementName="Root" Path="IsMaximizedOrFullScreened" Mode="OneWay">
                    <Binding.Converter>
                        <ajut_conv:BooleanToValueConverter>
                            <ajut_conv:BooleanToValueConverter.TrueValue>
                                <Thickness>0</Thickness>
                            </ajut_conv:BooleanToValueConverter.TrueValue>
                            <ajut_conv:BooleanToValueConverter.FalseValue>
                                <Thickness>10,0,10,10</Thickness>
                            </ajut_conv:BooleanToValueConverter.FalseValue>
                        </ajut_conv:BooleanToValueConverter>
                    </Binding.Converter>
                </Binding>
            </Border.BorderThickness>
            <Border x:Name="Colorization" BorderThickness="8,0,0,0"
                    Background="{Binding ElementName=Root, Path=Background}"
                    BorderBrush="{Binding ElementName=JewelBkgPath, Path=Fill}">
                <!-- The areas of the showroom. Each item's Tag names the area page it opens; the page lists its own
                     pages the same way, so the whole showroom is one navigation pattern. -->
                <NavigationView x:Name="AreaNav" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="170" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="0"
                                IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                                SelectionChanged="AreaNav_OnSelectionChanged" Loaded="AreaNav_OnLoaded">
                    <!-- The showroom's surfaces step up one level at a time from the title bar: the area list on the
                         drawer color, an area's own page list one step lighter, and the page itself on the panel color -->
                    <NavigationView.Resources>
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource AJut_Color_DrawerBackground}"/>
                        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource AJut_Color_DrawerBackground}"/>
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource AJut_Color_NavigationPanelBackground}"/>
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{ThemeResource AJut_Color_PanelBorder}"/>
                    </NavigationView.Resources>
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="Home" Tag="AJutShowRoomWinUI.UI.Pages.HomePage">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Controls" Tag="AJutShowRoomWinUI.UI.Pages.ControlsPage">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A9;"/></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Content Flows" Tag="AJutShowRoomWinUI.UI.Pages.ContentFlowsPage">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE90C;"/></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="UX Utils" Tag="AJutShowRoomWinUI.UI.Pages.UxUtilsPage">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;"/></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Strategies" Tag="AJutShowRoomWinUI.UI.Pages.StrategiesPage">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;"/></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Debug" Tag="AJutShowRoomWinUI.UI.Pages.DebugPage">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xEBE8;"/></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                    <NavigationView.PaneFooter>
                        <StackPanel Margin="12,0,12,12" Spacing="4" Opacity="0.8">
                            <TextBlock Text="App theme" FontSize="12" FontStyle="Italic"/>
                            <ajut:EnumComboBox SelectedItem="{x:Bind Path=Application.ThemeManager.ThemeConfiguration, Mode=TwoWay}"/>
                            <ToggleSwitch Header="Touch focused" FontSize="12" IsOn="{x:Bind Path=Application.ThemeManager.IsTouchFocused, Mode=TwoWay}"
                                          ToolTipService.ToolTip="The touch palette: lifted button surfaces and no button borders, for touch with no hover"/>
                            <ToggleSwitch Header="Follow Windows touch" FontSize="12" IsOn="{x:Bind Path=Application.TouchFocus.FollowsWindows, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Set Touch focused from Windows' touch preference (Windows 11 24H2 and later), the way an app opts in"/>
                            <TextBlock FontSize="12" FontStyle="Italic" TextWrapping="Wrap" Text="{x:Bind Path=Application.TouchFocus.WindowsPreferenceText, Mode=OneWay}"/>
                            <TextBlock FontSize="12" Margin="0,8,0,0" Text="ajut.core"/>
                            <TextBlock FontSize="12" FontFamily="Consolas" Text="{x:Bind Application.AJut_Core_Version}"/>
                            <TextBlock FontSize="12" Text="ajut.ux.winui3"/>
                            <TextBlock FontSize="12" FontFamily="Consolas" Text="{x:Bind Application.AJut_UX_WinUI_Version}"/>
                        </StackPanel>
                    </NavigationView.PaneFooter>
                    <Frame x:Name="AreaFrame"/>
                </NavigationView>
            </Border>
        </Border>
    </ajut:ThemedWindowRootControl>
</Window>
