<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Diagnostics.WindowManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="WindowManager" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="The showroom's own WindowManager, built around the main window. Open tool windows here and it tracks them: the order they were last active in, front to back, and whether they show and hide with the main window. Leaving the page closes them and puts the showroom's choice back."/>

            <StackPanel Spacing="4">
                <TextBlock Text="ShowHideChildrenWhen" FontSize="11" Opacity="0.7"/>
                <ajut:EnumToggleStrip SelectedItem="{x:Bind CoordinationStyle, Mode=TwoWay}"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                           Text="RootActivationDeactivation: click away to another app and the tool windows go; click the main window and they come back. RootMinimizationRestoration: minimize the main window and they go with it, restore it and they return."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open a tool window" Click="OpenToolWindow_OnClick"/>
                <Button Content="Hide all tool windows" Click="HideToolWindows_OnClick"/>
                <Button Content="Show all tool windows" Click="ShowToolWindows_OnClick"/>
                <Button Content="Close all tool windows" Click="CloseToolWindows_OnClick"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Front to back" FontSize="11" Opacity="0.7"/>
                <TextBlock x:Name="OrderReadout" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
