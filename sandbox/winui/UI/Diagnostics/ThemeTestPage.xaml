<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Diagnostics.ThemeTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="ThemeResource resolver" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Type a resource key and resolve it through the window chrome, the way a control finds a themed resource for itself. A color or brush result lands in the color picker. The last ten keys resolved are kept across runs; double-tap one in the list to put it back in the box. The standard controls underneath are here to show the current theme applied to them."/>

            <StackPanel Width="500" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SpecificThemeText" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="Resolve ThemeResource" Click="ThemeResolver_OnClick"/>
                </Grid>
                <ListBox x:Name="ThemeColorsList" Margin="0,10" MaxHeight="300" IsDoubleTapEnabled="True" DoubleTapped="ThemeColorsList_OnDoubleTapped" />
                <ColorPicker x:Name="ColorPicker"/>
                <MenuBar>
                    <MenuBarItem Title="File">
                        <MenuFlyoutItem Text="Open"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Exit"/>
                    </MenuBarItem>
                    <MenuBarItem Title="Edit">
                        <MenuFlyoutItem Text="Copy"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Undo"/>
                        <MenuFlyoutItem Text="Redo"/>
                    </MenuBarItem>
                </MenuBar>
                <NumberBox Value="3.14159"/>
                <ToggleSwitch OnContent="Ready" OffContent="Invalid"/>
                <ToggleButton>Toggle</ToggleButton>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
