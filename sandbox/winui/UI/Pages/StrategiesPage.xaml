<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Pages.StrategiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- One area of the showroom: the pane lists its pages, the frame shows the selected one. Each item's Tag is
         the full type name of the page it opens; ShowroomNavigation does the rest. -->
    <NavigationView x:Name="AreaNav" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="240" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="0"
                    IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                    SelectionChanged="AreaNav_OnSelectionChanged" Loaded="AreaNav_OnLoaded">
        <NavigationView.Resources>
            <ResourceDictionary Source="ms-appx:///Themes/AreaNavigationSurfaces.xaml"/>
        </NavigationView.Resources>
        <NavigationView.PaneHeader>
            <StackPanel Margin="12,8,12,4">
                <TextBlock Text="Strategies" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Worked examples. Each one starts from something you might want to do, and builds it with AJut, code beside the result." TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Undo and Redo" Tag="AJutShowRoomWinUI.UI.Strategies.UndoRedoPage"/>
            <NavigationViewItem Content="Settings as JSON" Tag="AJutShowRoomWinUI.UI.Strategies.SettingsAsJsonPage"/>
            <NavigationViewItem Content="Layered Overrides with Stratabase" Tag="AJutShowRoomWinUI.UI.Strategies.LayeredOverridesPage"/>
            <NavigationViewItem Content="Edit Any Object" Tag="AJutShowRoomWinUI.UI.Strategies.EditAnyObjectPage"/>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <TextBlock Margin="12,4,12,12" TextWrapping="Wrap" Opacity="0.6" FontSize="12" Text="The same four examples are in the WPF showroom."/>
        </NavigationView.PaneFooter>
        <Frame x:Name="AreaFrame"/>
    </NavigationView>
</Page>
