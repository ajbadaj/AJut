<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="AreaCard" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="300"/>
        </Style>
        <Style x:Key="AreaTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="AreaBlurb" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
    </Page.Resources>
    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="What do we have here?" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap"
                       Text="This app shows most of what AJut.UX.WinUI3 can do, with the markup and code beside each example, and it is the testing ground for the library: the probes that found real defects live in the Debug area and stay runnable."/>
            <TextBlock TextWrapping="Wrap" Text="Pick an area on the left, or from the cards below. The WPF showroom has the same areas and the same page names, so what you find here you can find there."/>

            <Border BorderThickness="1" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="4" Padding="14" Margin="0,8,0,8">
                <StackPanel Spacing="10">
                    <TextBlock Text="A quick taste" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <ajut:NumericEditor Width="110" Value="42" VerticalAlignment="Center"/>
                        <ajut:ToggleStrip x:Name="TasteStrip" VerticalAlignment="Center"/>
                        <ajut:GeometryButton Content="Geometry button" BackgroundGeometry="M 0,0 20,20 40,0 150,0 150,100 100,90 0,100 Z" TraceThickness="1" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ajut:SimpleWrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <Border Style="{StaticResource AreaCard}">
                    <StackPanel>
                        <TextBlock Text="Controls" Style="{StaticResource AreaTitle}"/>
                        <TextBlock Style="{StaticResource AreaBlurb}" Text="The standalone controls: NumericEditor, ToggleStrip, PropertyGrid, FlatTreeListControl and the rest, one page each."/>
                        <Button Content="Explore controls" Click="NavControls_OnClick"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AreaCard}">
                    <StackPanel>
                        <TextBlock Text="Content Flows" Style="{StaticResource AreaTitle}"/>
                        <TextBlock Style="{StaticResource AreaBlurb}" Text="More than a control: the docking framework, with its models, controls and managers working together."/>
                        <Button Content="Explore content flows" Click="NavContentFlows_OnClick"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AreaCard}">
                    <StackPanel>
                        <TextBlock Text="UX Utils" Style="{StaticResource AreaTitle}"/>
                        <TextBlock Style="{StaticResource AreaBlurb}" Text="Converters for markup, and the code-side helpers: dependency property registration, visual tree walking, coercion and color math."/>
                        <Button Content="Explore UX utils" Click="NavUxUtils_OnClick"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AreaCard}">
                    <StackPanel>
                        <TextBlock Text="Strategies" Style="{StaticResource AreaTitle}"/>
                        <TextBlock Style="{StaticResource AreaBlurb}" Text="Worked examples: maybe you want undo and redo, settings saved as JSON, layered overrides, or to edit any object. Here is each, built with AJut."/>
                        <Button Content="Explore strategies" Click="NavStrategies_OnClick"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AreaCard}">
                    <StackPanel>
                        <TextBlock Text="Debug" Style="{StaticResource AreaTitle}"/>
                        <TextBlock Style="{StaticResource AreaBlurb}" Text="The probes, repros and diagnostics, including the window chrome and leak probes. Kept apart from the demos on purpose."/>
                        <Button Content="Open the debug area" Click="NavDebug_OnClick"/>
                    </StackPanel>
                </Border>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
