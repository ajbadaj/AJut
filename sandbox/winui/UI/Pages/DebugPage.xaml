<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Pages.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- One area of the showroom: the pane lists its pages, the frame shows the selected one. Each item's Tag is
         the full type name of the page it opens; ShowroomNavigation does the rest. -->
    <NavigationView x:Name="AreaNav" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="240" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="0"
                    IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                    SelectionChanged="AreaNav_OnSelectionChanged" Loaded="AreaNav_OnLoaded">
        <NavigationView.Resources>
            <ResourceDictionary Source="ms-appx:///Themes/AreaNavigationSurfaces.xaml"/>
        </NavigationView.Resources>
        <NavigationView.PaneHeader>
            <StackPanel Margin="12,8,12,4">
                <TextBlock Text="Debug" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Probes, repros and diagnostics: the checks that found real defects, kept runnable. Not demos." TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="ThemeResource resolver" Tag="AJutShowRoomWinUI.UI.Diagnostics.ThemeTestPage"/>
            <NavigationViewItem Content="Palette Doubles" Tag="AJutShowRoomWinUI.UI.Diagnostics.PaletteDoublesPage"/>
            <NavigationViewItem Content="PropertyGrid debug" Tag="AJutShowRoomWinUI.UI.Diagnostics.PropertyGridDebugPage"/>
            <NavigationViewItem Content="Standard controls" Tag="AJutShowRoomWinUI.UI.Diagnostics.StandardControlsPage"/>
            <NavigationViewItem Content="Window Chrome" Tag="AJutShowRoomWinUI.UI.Diagnostics.WindowChromePage"/>
            <NavigationViewItem Content="Leak Probe" Tag="AJutShowRoomWinUI.UI.Diagnostics.LeakProbePage"/>
            <NavigationViewItem Content="Use-Case Leak Test" Tag="AJutShowRoomWinUI.UI.Diagnostics.UseCaseLeakTestPage"/>
            <NavigationViewItem Content="Crash Filter" Tag="AJutShowRoomWinUI.UI.Diagnostics.CrashFilterPage"/>
            <NavigationViewItem Content="ToggleStrip repros" Tag="AJutShowRoomWinUI.UI.Diagnostics.ToggleStripReprosPage"/>
            <NavigationViewItem Content="Typed-path probe" Tag="AJutShowRoomWinUI.UI.Diagnostics.TypedPathProbePage"/>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <TextBlock Margin="12,4,12,12" TextWrapping="Wrap" Opacity="0.6" FontSize="12" Text="WinUI3 only: everything here probes AJut.UX.WinUI3. The WPF showroom has a Debug area of its own."/>
        </NavigationView.PaneFooter>
        <Frame x:Name="AreaFrame"/>
    </NavigationView>
</Page>
