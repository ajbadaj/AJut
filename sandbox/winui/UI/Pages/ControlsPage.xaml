<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Pages.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- One area of the showroom: the pane lists its pages, the frame shows the selected one. Each item's Tag is
         the full type name of the page it opens; ShowroomNavigation does the rest. -->
    <NavigationView x:Name="AreaNav" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="240" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="0"
                    IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                    SelectionChanged="AreaNav_OnSelectionChanged" Loaded="AreaNav_OnLoaded">
        <NavigationView.PaneHeader>
            <StackPanel Margin="12,8,12,4">
                <TextBlock Text="Controls" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Standalone controls in AJut.UX.WinUI3, one page per control, with the markup beside each demo." TextWrapping="Wrap" Opacity="0.7" FontSize="12"/>
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="BrushButton" Tag="AJutShowRoomWinUI.UI.Controls.BrushButtonPage"/>
            <NavigationViewItem Content="BumpStack" Tag="AJutShowRoomWinUI.UI.Controls.BumpStackPage"/>
            <NavigationViewItem Content="ColorEditIngressControl" Tag="AJutShowRoomWinUI.UI.Controls.ColorEditIngressControlPage"/>
            <NavigationViewItem Content="EnumComboBox" Tag="AJutShowRoomWinUI.UI.Controls.EnumComboBoxPage"/>
            <NavigationViewItem Content="EnumToggleStrip" Tag="AJutShowRoomWinUI.UI.Controls.EnumToggleStripPage"/>
            <NavigationViewItem Content="FlatTreeListControl" Tag="AJutShowRoomWinUI.UI.Controls.FlatTreeListControlPage"/>
            <NavigationViewItem Content="GeometryButton (WinUI3 only)" Tag="AJutShowRoomWinUI.UI.Controls.GeometryButtonPage"/>
            <NavigationViewItem Content="GridSplitter (WinUI3 only)" Tag="AJutShowRoomWinUI.UI.Controls.GridSplitterPage"/>
            <NavigationViewItem Content="NumericEditor" Tag="AJutShowRoomWinUI.UI.Controls.NumericEditorPage"/>
            <NavigationViewItem Content="PathSelectionControl" Tag="AJutShowRoomWinUI.UI.Controls.PathSelectionControlPage"/>
            <NavigationViewItem Content="PopupMenuButton" Tag="AJutShowRoomWinUI.UI.Controls.PopupMenuButtonPage"/>
            <NavigationViewItem Content="PropertyGrid" Tag="AJutShowRoomWinUI.UI.Controls.PropertyGridPage"/>
            <NavigationViewItem Content="SimpleWrapPanel (WinUI3 only)" Tag="AJutShowRoomWinUI.UI.Controls.SimpleWrapPanelPage"/>
            <NavigationViewItem Content="ToggleStrip" Tag="AJutShowRoomWinUI.UI.Controls.ToggleStripPage"/>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <TextBlock Margin="12,4,12,12" TextWrapping="Wrap" Opacity="0.6" FontSize="12" Text="WPF only, shown in the WPF showroom: AutoGrid, BusyWait, ColorValueEditControl, EditableTextBlock, Svg, ToggleSwitchButton, WindowChromeButtonStrip."/>
        </NavigationView.PaneFooter>
        <Frame x:Name="AreaFrame"/>
    </NavigationView>
</Page>
