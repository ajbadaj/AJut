<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Controls.ColorEditIngressControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ajut_conv="using:AJut.UX.Converters"
    xmlns:ui="using:AJutShowRoomWinUI.UI"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="ColorEditIngressControl" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Shows the color swatch with hover edit overlay and glossy cover. EditColor is the color it shows and edits, and it binds both ways."/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Solid red" FontSize="11" Opacity="0.7"/>
                    <ajut:ColorEditIngressControl Width="60" Height="40" EditColor="#FF0000"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Blue" FontSize="11" Opacity="0.7"/>
                    <ajut:ColorEditIngressControl Width="60" Height="40" EditColor="#0000CC"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Semi-transparent orange" FontSize="11" Opacity="0.7"/>
                    <ajut:ColorEditIngressControl Width="60" Height="40" EditColor="{Binding ElementName=ColorText, Path=Text, Mode=TwoWay, Converter={ajut_conv:ColorStringToColorConverter}}"/>
                    <TextBlock Text="(Color bound to text via converter)" FontSize="11" Opacity="0.7"/>
                    <TextBox x:Name="ColorText"  Text="#C9DB733F"/>
                </StackPanel>
            </StackPanel>

            <ui:ShowroomCodeDisplay CodeText="{x:Bind DemoCode}" Height="160"/>
        </StackPanel>
    </ScrollViewer>
</Page>
