<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Controls.NumericEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ui="using:AJutShowRoomWinUI.UI"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="NumericEditor" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Gradient background, Consolas font, rim-lighting border, focus highlight, AJut-themed spin buttons. EnforceNumericType keeps the value in one type however it arrives (a XAML literal arrives as text), Minimum and Maximum clamp, Nudge sets the spin step, and LabelContent puts anything you like in front of the value."/>

            <Grid MaxWidth="420" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Integer" VerticalAlignment="Center" Margin="0,4"/>
                <ajut:NumericEditor Grid.Row="0" Grid.Column="1" Value="42" EnforceNumericType="{x:Bind IntegerType}" Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Float" VerticalAlignment="Center" Margin="0,4"/>
                <ajut:NumericEditor Grid.Row="1" Grid.Column="1" Value="3.14" EnforceNumericType="{x:Bind FloatType}" Margin="0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Double" VerticalAlignment="Center" Margin="0,4"/>
                <ajut:NumericEditor Grid.Row="2" Grid.Column="1" Value="2.71828" EnforceNumericType="{x:Bind DoubleType}" Margin="0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Clamped (0-100)" VerticalAlignment="Center" Margin="0,4"/>
                <ajut:NumericEditor Grid.Row="3" Grid.Column="1" Value="50" Minimum="0" Maximum="100" Margin="0,4"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Step by 0.5" VerticalAlignment="Center" Margin="0,4"/>
                <ajut:NumericEditor Grid.Row="4" Grid.Column="1" Value="1.5" Nudge="0.5" Margin="0,4"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Override Labels" VerticalAlignment="Top" Margin="0,4"/>
                <StackPanel Grid.Row="5" Grid.Column="1">
                    <ajut:NumericEditor Value="1.5" Nudge="0.5" Margin="0,4">
                        <ajut:NumericEditor.LabelContent>
                            <TextBlock Text="X" Foreground="Red" FontWeight="Bold" Margin="5,0" VerticalAlignment="Center" FontSize="20" FontFamily="Segoe UI"/>
                        </ajut:NumericEditor.LabelContent>
                    </ajut:NumericEditor>
                    <ajut:NumericEditor Value="1.5" Nudge="0.5" Margin="0,4">
                        <ajut:NumericEditor.LabelContent>
                            <TextBlock Text="Y" Foreground="#5C3" FontWeight="Bold" Margin="5,0" VerticalAlignment="Center" FontSize="20" FontFamily="Segoe UI"/>
                        </ajut:NumericEditor.LabelContent>
                    </ajut:NumericEditor>
                    <ajut:NumericEditor Value="1.5" Nudge="0.5" Margin="0,4">
                        <ajut:NumericEditor.LabelContent>
                            <TextBlock Text="Z" Foreground="#38F" FontWeight="Bold" Margin="5,0" VerticalAlignment="Center" FontSize="20" FontFamily="Segoe UI"/>
                        </ajut:NumericEditor.LabelContent>
                    </ajut:NumericEditor>
                </StackPanel>
            </Grid>

            <ui:ShowroomCodeDisplay CodeText="{x:Bind DemoCode}" Height="220"/>
        </StackPanel>
    </ScrollViewer>
</Page>
