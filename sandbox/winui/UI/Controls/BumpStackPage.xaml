<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Controls.BumpStackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ui="using:AJutShowRoomWinUI.UI"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="BumpStack" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="A scroll container with a chevron 'bump' button at each end instead of a scrollbar. The buttons appear only when the content overflows, disable at each end, and the content insets so scrolling all the way parks a button over empty padding. Mouse wheel scrolls a horizontal stack."/>

            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Horizontal (constrained width - chevrons appear, resize narrower to see more)" FontSize="11" Opacity="0.7"/>
                    <ajut:BumpStack x:Name="BumpStackHorizontal" Width="320" Height="44" HorizontalAlignment="Left"
                                    BorderBrush="#80808080" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Vertical" FontSize="11" Opacity="0.7"/>
                    <ajut:BumpStack x:Name="BumpStackVertical" Orientation="Vertical" Width="160" Height="130" HorizontalAlignment="Left"
                                    BorderBrush="#80808080" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="ScrollingEnabled=False (clip-only - no buttons, content just clips)" FontSize="11" Opacity="0.7"/>
                    <ajut:BumpStack x:Name="BumpStackClip" Width="320" Height="44" HorizontalAlignment="Left" ScrollingEnabled="False"
                                    BorderBrush="#80808080" BorderThickness="1"/>
                </StackPanel>
            </StackPanel>

            <ui:ShowroomCodeDisplay CodeText="{x:Bind DemoCode}" Height="160"/>
        </StackPanel>
    </ScrollViewer>
</Page>
