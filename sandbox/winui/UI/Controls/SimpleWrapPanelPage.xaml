<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Controls.SimpleWrapPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ui="using:AJutShowRoomWinUI.UI"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="SimpleWrapPanel" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Flows items left to right and wraps to the next line when the next one would overflow. HorizontalSpacing / VerticalSpacing gap the items; collapsed children take no slot. One item (Epsilon) starts collapsed - clicking Reveal must pop it into the flow. Resize the window narrower to watch it wrap."/>

            <StackPanel Spacing="8">
                <Border BorderBrush="#80808080" BorderThickness="1" Width="360" HorizontalAlignment="Left" Padding="6">
                    <ajut:SimpleWrapPanel x:Name="WrapPanelDemo"/>
                </Border>
                <Button Content="Reveal/hide the item that starts collapsed" Click="WrapPanelToggleCollapse_OnClick" HorizontalAlignment="Left"/>
            </StackPanel>

            <ui:ShowroomCodeDisplay CodeText="{x:Bind DemoCode}" Height="120"/>
        </StackPanel>
    </ScrollViewer>
</Page>
