<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Controls.PathSelectionControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ui="using:AJutShowRoomWinUI.UI"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="PathSelectionControl" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Browse button opens OS file/folder picker. Invalid paths show red border + warning icon."/>

            <StackPanel Spacing="12" MaxWidth="500" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="File picker (open)" FontSize="11" Opacity="0.7"/>
                    <ajut:PathSelectionControl x:Name="PathPickFile"
                                               PathType="File"
                                               TextBoxHeight="22"
                                               UnsetTextPrompt="Select a file..."
                                               TreatEmptyPathAsInvalid="True"
                                               TreatNonExistentPathAsInvalid="True"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Folder picker" FontSize="11" Opacity="0.7"/>
                    <ajut:PathSelectionControl x:Name="PathPickFolder"
                                               PathType="Folder"
                                               UnsetTextPrompt="Select a folder..."
                                               IsOpenInExplorerButtonAllowed="True"
                                               TreatNonExistentPathAsInvalid="True"
                                               TextBoxPadding="0"
                                               />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="File picker (save, validates extension)" FontSize="11" Opacity="0.7"/>
                    <ajut:PathSelectionControl x:Name="PathPickSaveFile"
                                                PathType="File"
                                                FileDialogType="SaveFile"
                                                FileFilter="Text files (*.txt)|*.txt"
                                                UnsetTextPrompt="Save path..."/>
                </StackPanel>
            </StackPanel>

            <ui:ShowroomCodeDisplay CodeText="{x:Bind DemoCode}" Height="220"/>
        </StackPanel>
    </ScrollViewer>
</Page>
