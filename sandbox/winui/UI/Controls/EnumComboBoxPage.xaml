<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Controls.EnumComboBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ui="using:AJutShowRoomWinUI.UI"
    mc:Ignorable="d">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="EnumComboBox" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="A ComboBox that fills itself from an enum. Bind SelectedItem to an enum-typed property and the control lists every value of that enum, no ItemsSource needed. The theme switcher in the navigation pane is one of these over ElementTheme. Bind it to a plain property that checks equality before raising a change: an enum-typed dependency property reports a change on every set, and a two-way binding to one loops until the stack overflows."/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Pick a day:" VerticalAlignment="Center"/>
                <ajut:EnumComboBox SelectedItem="{x:Bind Day, Mode=TwoWay}" Width="160"/>
                <TextBlock Text="{x:Bind DayDescription, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
            </StackPanel>
            <ui:ShowroomCodeDisplay CodeText="{x:Bind DemoCode}" Height="150"/>
        </StackPanel>
    </ScrollViewer>
</Page>
