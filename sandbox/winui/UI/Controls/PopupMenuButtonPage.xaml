<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Controls.PopupMenuButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ui="using:AJutShowRoomWinUI.UI"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="PopupMenuButton" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="A ToggleButton that opens a MenuFlyout. Button stays 'checked' (accent) while flyout is open."/>

            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Simple menu" FontSize="11" Opacity="0.7"/>
                    <ajut:PopupMenuButton>
                        <ajut:PopupMenuButton.ButtonContent>
                            <TextBlock Text="Actions" VerticalAlignment="Center"/>
                        </ajut:PopupMenuButton.ButtonContent>
                        <ajut:PopupMenuButton.MenuItems>
                            <MenuFlyoutItem Text="New File"/>
                            <MenuFlyoutItem Text="Open..."/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Exit"/>
                        </ajut:PopupMenuButton.MenuItems>
                    </ajut:PopupMenuButton>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Edit menu" FontSize="11" Opacity="0.7"/>
                    <ajut:PopupMenuButton>
                        <ajut:PopupMenuButton.ButtonContent>
                            <TextBlock Text="Edit" VerticalAlignment="Center"/>
                        </ajut:PopupMenuButton.ButtonContent>
                        <ajut:PopupMenuButton.MenuItems>
                            <MenuFlyoutItem Text="Cut"/>
                            <MenuFlyoutItem Text="Copy"/>
                            <MenuFlyoutItem Text="Paste"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Select All"/>
                        </ajut:PopupMenuButton.MenuItems>
                    </ajut:PopupMenuButton>
                </StackPanel>
            </StackPanel>

            <ui:ShowroomCodeDisplay CodeText="{x:Bind DemoCode}" Height="200"/>
        </StackPanel>
    </ScrollViewer>
</Page>
