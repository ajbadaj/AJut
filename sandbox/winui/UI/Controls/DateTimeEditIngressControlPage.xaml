<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Controls.DateTimeEditIngressControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ui="using:AJutShowRoomWinUI.UI"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="DateTimeEditIngressControl" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Shows a date, a time, or both, and takes typed text as well as picks from a calendar and time picker. Try: today, tomorrow, friday, next friday, in two weeks, +3d, -2w, 2026-12-24, friday 3pm, tomorrow at 15:30. Enter takes what is typed, and Escape puts the value back."/>

            <!-- ====[ Try the settings: one field, set from the controls above it ]==== -->
            <StackPanel Spacing="6" Width="420" HorizontalAlignment="Left">
                <CheckBox x:Name="IncludeDateCheck" Content="Include date" IsChecked="True"/>
                <CheckBox x:Name="IncludeTimeCheck" Content="Include time"/>
                <CheckBox x:Name="EmptyAsErrorCheck" Content="Treat empty as error"/>
                <CheckBox x:Name="ReadOnlyCheck" Content="Read-only"/>
                <TextBox x:Name="DisplayFormatBox" Header="Display format"
                         ToolTipService.ToolTip="A .NET date and time format, standard (d, D, g, f) or custom (yyyy-MM-dd). Empty shows the culture's own short form."/>

                <!-- Formats to try: each sets the display format box -->
                <ajut:SimpleWrapPanel HorizontalSpacing="4" VerticalSpacing="4">
                    <Button Content="d" ToolTipService.ToolTip="Short date" Click="DisplayFormatSuggestion_OnClick"/>
                    <Button Content="D" ToolTipService.ToolTip="Long date" Click="DisplayFormatSuggestion_OnClick"/>
                    <Button Content="g" ToolTipService.ToolTip="Short date and time" Click="DisplayFormatSuggestion_OnClick"/>
                    <Button Content="f" ToolTipService.ToolTip="Long date, short time" Click="DisplayFormatSuggestion_OnClick"/>
                    <Button Content="yyyy-MM-dd" ToolTipService.ToolTip="Year, month and day, as ISO 8601 writes them" Click="DisplayFormatSuggestion_OnClick"/>
                    <Button Content="ddd, MMM d" ToolTipService.ToolTip="Weekday, month and day" Click="DisplayFormatSuggestion_OnClick"/>
                    <Button Content="MMMM yyyy" ToolTipService.ToolTip="Month and year" Click="DisplayFormatSuggestion_OnClick"/>
                    <Button Content="h:mm tt" ToolTipService.ToolTip="Time on a twelve hour clock" Click="DisplayFormatSuggestion_OnClick"/>
                </ajut:SimpleWrapPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Time format" VerticalAlignment="Center"/>
                    <ajut:EnumComboBox SelectedItem="{x:Bind MainTimeFormat, Mode=TwoWay}" Width="160"
                                       ToolTipService.ToolTip="The clock a time is shown and picked on, while there is no display format. CurrentCulture is the default."/>
                </StackPanel>

                <ajut:DateTimeEditIngressControl x:Name="Main"
                                                 IncludeDate="{Binding ElementName=IncludeDateCheck, Path=IsChecked}"
                                                 IncludeTime="{Binding ElementName=IncludeTimeCheck, Path=IsChecked}"
                                                 TreatEmptyAsInvalid="{Binding ElementName=EmptyAsErrorCheck, Path=IsChecked}"
                                                 IsReadOnly="{Binding ElementName=ReadOnlyCheck, Path=IsChecked}"
                                                 DisplayFormat="{x:Bind DisplayFormatBox.Text, Mode=OneWay}"
                                                 UnsetTextPrompt="No date: type one, or pick"/>
            </StackPanel>

            <StackPanel Spacing="4" Width="320" HorizontalAlignment="Left">
                <TextBlock Text="Date only" FontSize="11" Opacity="0.7"/>
                <ajut:DateTimeEditIngressControl x:Name="DateOnly" UnsetTextPrompt="No date: type one, or pick"/>
            </StackPanel>

            <StackPanel Spacing="4" Width="320" HorizontalAlignment="Left">
                <TextBlock Text="Time only" FontSize="11" Opacity="0.7"/>
                <ajut:DateTimeEditIngressControl x:Name="TimeOnly" IncludeDate="False" IncludeTime="True" UnsetTextPrompt="No time"/>
            </StackPanel>

            <StackPanel Spacing="4" Width="320" HorizontalAlignment="Left">
                <TextBlock Text="Date and time on a twenty four hour clock, whatever the culture" FontSize="11" Opacity="0.7"/>
                <ajut:DateTimeEditIngressControl x:Name="TwentyFourHour" IncludeTime="True" TimeFormat="TwentyFourHour"/>
            </StackPanel>

            <StackPanel Spacing="4" Width="320" HorizontalAlignment="Left">
                <TextBlock Text="Date and time on a twelve hour clock, whatever the culture" FontSize="11" Opacity="0.7"/>
                <ajut:DateTimeEditIngressControl x:Name="TwelveHour" IncludeTime="True" TimeFormat="TwelveHour"/>
            </StackPanel>

            <StackPanel Spacing="4" Width="320" HorizontalAlignment="Left">
                <TextBlock Text="Date and time, shown in a format of its own" FontSize="11" Opacity="0.7"/>
                <ajut:DateTimeEditIngressControl x:Name="DateAndTime" IncludeTime="True" DisplayFormat="ddd, MMM d yyyy 'at' h:mm tt"/>
            </StackPanel>

            <StackPanel Spacing="4" Width="320" HorizontalAlignment="Left">
                <TextBlock Text="A resolver of its own: q1 to q4 are quarters, and values show as one" FontSize="11" Opacity="0.7"/>
                <ajut:DateTimeEditIngressControl x:Name="Quarters" UnsetTextPrompt="q1, q2, q3 or q4"/>
            </StackPanel>

            <StackPanel Spacing="4" Width="320" HorizontalAlignment="Left">
                <TextBlock Text="Empty is invalid" FontSize="11" Opacity="0.7"/>
                <ajut:DateTimeEditIngressControl TreatEmptyAsInvalid="True" UnsetTextPrompt="A date is needed"/>
            </StackPanel>

            <StackPanel Spacing="4" Width="320" HorizontalAlignment="Left">
                <TextBlock Text="Read-only" FontSize="11" Opacity="0.7"/>
                <ajut:DateTimeEditIngressControl x:Name="ReadOnlyDate" IncludeTime="True" IsReadOnly="True"/>
            </StackPanel>

            <ui:ShowroomCodeDisplay CodeText="{x:Bind DemoCode}" Height="260"/>
        </StackPanel>
    </ScrollViewer>
</Page>
