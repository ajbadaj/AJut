<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AJutShowRoomWinUI.UI.Strategies.SettingsAsJsonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ajut="using:AJut.UX.Controls"
    xmlns:ui="using:AJutShowRoomWinUI.UI"
    mc:Ignorable="d"
    x:Name="Self">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Settings as JSON" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="Maybe you want app settings saved to a file and read back, without annotating every property or writing a serializer. Here it is, built with AJson from AJut.Core: a plain class with plain properties, JsonHelper.BuildJsonForObject to write it, and JsonHelper.BuildObjectForJson to read it back. Edit the fields and press Save to see the JSON; edit the JSON by hand and press Load to see the fields follow."/>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ====[ The settings object, edited directly ]==== -->
                <StackPanel Spacing="8">
                    <TextBox Header="User name" Text="{x:Bind Settings.UserName, Mode=TwoWay}"/>
                    <ajut:NumericEditor LabelContent="Font size" Minimum="6" Maximum="72"
                                        Value="{Binding ElementName=Self, Path=Settings.FontSize, Mode=TwoWay}"/>
                    <ToggleSwitch Header="Dark mode" IsOn="{x:Bind Settings.UseDarkMode, Mode=TwoWay}"/>
                    <TextBox Header="Last opened folder" Text="{x:Bind Settings.LastOpenedFolder, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save to JSON" Click="Save_OnClick"/>
                        <Button Content="Load from JSON" Click="Load_OnClick"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8"/>
                </StackPanel>

                <!-- ====[ The JSON text, editable so Load has something to read ]==== -->
                <TextBox Grid.Column="1" Header="JSON" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="12" Height="220" IsSpellCheckEnabled="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Text="{x:Bind JsonText, Mode=TwoWay}"/>
            </Grid>

            <ui:ShowroomCodeDisplay CodeText="{x:Bind DemoCode}" Height="260"/>
        </StackPanel>
    </ScrollViewer>
</Page>
