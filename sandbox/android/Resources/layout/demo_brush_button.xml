<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BrushButton"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="Per-state colors are plain properties, and layout attributes. Every slot left unset paints the standard button color, so an untouched button behaves normally and you override only the slots you want." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <ajut.ux.controls.BrushButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Default" />

        <ajut.ux.controls.BrushButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Custom red"
            app:ajutNormalBackground="#C0392B"
            app:ajutNormalForeground="#FFFFFF"
            app:ajutPressedBackground="#96281B"
            app:ajutPressedForeground="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ajut.ux.controls.BrushButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Border only"
            app:ajutBorderThickness="2dp"
            app:ajutNormalBorder="#2ECC71"
            app:ajutPressedBorder="#1E8449" />

        <ajut.ux.controls.BrushButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Disabled" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="AutoBrushButton"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="One accent color in, a coherent readable palette out: a contrasting foreground, a visible border, and the pressed and disabled variants. With no accent set it uses the system accent." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <ajut.ux.controls.AutoBrushButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Dark red"
            app:ajutPropagatedAccentColor="#8B0000" />

        <ajut.ux.controls.AutoBrushButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Blue"
            app:ajutPropagatedAccentColor="#0D83D8" />

        <ajut.ux.controls.AutoBrushButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gold"
            app:ajutPropagatedAccentColor="#FFD700" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ajut.ux.controls.AutoBrushButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="System accent" />

        <ajut.ux.controls.AutoBrushButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Disabled"
            app:ajutPropagatedAccentColor="#8B0000" />
    </LinearLayout>
</LinearLayout>
