<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NumericEditor"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="A number field with step buttons. It keeps the value's own type, so an int steps as an int, and caps it to its bounds. Hold a step button to repeat it." />

    <ajut.ux.controls.NumericEditor
        android:id="@+id/demo_numeric_int"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:ajutLabel="Count (0 to 20)"
        app:ajutMaximum="20"
        app:ajutMinimum="0" />

    <TextView
        android:id="@+id/demo_numeric_int_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace" />

    <ajut.ux.controls.NumericEditor
        android:id="@+id/demo_numeric_double"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:ajutDecimalPlacesAllowed="2"
        app:ajutLabel="Scale"
        app:ajutMaximum="4"
        app:ajutMinimum="0.25"
        app:ajutNudge="0.25"
        app:ajutOutOfBoundsResponse="fixOnCommit" />

    <TextView
        android:id="@+id/demo_numeric_double_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace" />
</LinearLayout>
