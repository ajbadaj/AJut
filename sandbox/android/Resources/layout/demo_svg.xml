<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Svg"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="Draws an svg file through AJut.UX's SvgParsing, the same read WPF's Svg draws from. This is the WPF showroom's penguin, from its own file, fitted with ajutSvgStretch=uniform." />

    <ajut.ux.controls.Svg
        android:id="@+id/demo_svg_penguin"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        app:ajutSvgSource="@raw/penguin_example"
        app:ajutSvgStretch="uniform" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:alpha="0.7"
        android:text="A 24 unit icon on a viewBox, made of a polygon and a circle with its paint set on a group, read from text in code: at its own size, then fitted into 96dp." />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ajut.ux.controls.Svg
            android:id="@+id/demo_svg_icon_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ajut.ux.controls.Svg
            android:id="@+id/demo_svg_icon_large"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="16dp"
            app:ajutSvgStretch="uniform" />
    </LinearLayout>
</LinearLayout>
