<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UIElementRepeater"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="Shows a collection of views in a container and keeps them in step with it. Here the container is an AutoGrid three columns wide, written inside the repeater, and the collection is an ObservableCollection the buttons change." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/demo_repeater_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add" />

        <Button
            android:id="@+id/demo_repeater_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Take one" />

        <Button
            android:id="@+id/demo_repeater_move"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="First to last" />

        <Button
            android:id="@+id/demo_repeater_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Clear" />
    </LinearLayout>

    <TextView
        android:id="@+id/demo_repeater_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <ajut.ux.controls.UIElementRepeater
        android:id="@+id/demo_repeater"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp">

        <ajut.ux.controls.AutoGrid
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:ajutFixedColumnCount="3" />
    </ajut.ux.controls.UIElementRepeater>
</LinearLayout>
