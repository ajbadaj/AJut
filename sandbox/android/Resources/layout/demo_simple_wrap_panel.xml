<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SimpleWrapPanel"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="Flows its children left to right at their own size and wraps to the next line when the next one would run past the width. ajutHorizontalSpacing and ajutVerticalSpacing gap them, and a child that is gone takes no place. Epsilon starts gone: the button brings it back into the flow. Turn the phone to see the lines rewrap." />

    <Button
        android:id="@+id/demo_wrap_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Show or hide Epsilon" />

    <ajut.ux.controls.SimpleWrapPanel
        android:id="@+id/demo_wrap_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="6dp"
        app:ajutHorizontalSpacing="8dp"
        app:ajutVerticalSpacing="6dp" />
</LinearLayout>
