<?xml version="1.0" encoding="utf-8"?>
<!-- The showroom shell. The page title and back live in the activity's action bar. Under it, the theme bar picks
     the look on every page, and the page goes under that. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/theme_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ajut.ux.controls.EnumToggleStrip
            android:id="@+id/theme_bar_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ajutEnsureUniformSize="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Switch
            android:id="@+id/theme_bar_touch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Touch" />

        <Switch
            android:id="@+id/theme_bar_ajut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="AJut" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <FrameLayout
        android:id="@+id/shell_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
