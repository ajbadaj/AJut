<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ajut.ux.controls.AutoGrid
        android:id="@+id/auto_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:enabled="false"
        app:ajutFixedColumnCount="2"
        app:ajutFixedRowCount="3"
        app:ajutAutoPopulationOrder="rowsFirst"
        app:ajutAddColumnResizers="true"
        app:ajutAddRowResizers="true"
        app:ajutShrinkRowColumnsToUtilizedElementCount="true"
        app:ajutBorderThickness="3px"
        app:ajutBorderBrush="#FFFF0000">

        <View android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <View android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <View android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <View android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </ajut.ux.controls.AutoGrid>
</FrameLayout>
