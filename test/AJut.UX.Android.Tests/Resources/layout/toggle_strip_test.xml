<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ajut.ux.controls.ToggleStrip
        android:id="@+id/toggle_strip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ajutItems="@array/toggle_strip_test_items"
        app:ajutAllowMultiSelect="true"
        app:ajutOverflowBehavior="scroll" />

    <ajut.ux.controls.ToggleStrip
        android:id="@+id/toggle_strip_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ajutItems="@array/toggle_strip_test_items"
        app:ajutOrientation="vertical" />

    <ajut.ux.controls.EnumToggleStrip
        android:id="@+id/enum_toggle_strip_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ajutOrientation="vertical" />
</FrameLayout>
