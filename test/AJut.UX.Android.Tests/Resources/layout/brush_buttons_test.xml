<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ajut.ux.controls.AutoBrushButton
        android:id="@+id/auto_brush_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto"
        app:ajutPropagatedAccentColor="#FF7A1FA2"
        app:ajutCornerRadius="10px"
        app:ajutBorderThickness="3px" />

    <ajut.ux.controls.BrushButton
        android:id="@+id/brush_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Brush"
        app:ajutNormalBackground="#FF112233"
        app:ajutPressedForeground="#FFAABBCC" />
</LinearLayout>
