<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<WindowsPackageType>None</WindowsPackageType>
		<IsPackable>false</IsPackable>
		<!-- Unpackaged and not self-contained, so the Windows App SDK compiles in a module initializer that finds the
		     Windows App Runtime before any test runs. By default it asks to install the runtime when it is missing, and on a
		     machine nobody is watching, like CI, that prompt waits forever. With no options it fails instead, and the test
		     host exits with the bootstrapper's error code. CI installs the runtime first: see
		     .github/scripts/install-windows-app-runtime.ps1. -->
		<WindowsAppSDKBootstrapAutoInitializeOptions_None>true</WindowsAppSDKBootstrapAutoInitializeOptions_None>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MSTest" Version="4.5.2" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\libs\AJut.UX\AJut.UX.csproj" />
		<ProjectReference Include="..\..\libs\AJut.UX.WinUI3\AJut.UX.WinUI3.csproj" />
	</ItemGroup>

</Project>
