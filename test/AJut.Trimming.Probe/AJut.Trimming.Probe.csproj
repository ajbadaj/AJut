<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Most aggressive trim mode - we want to prove the generated path survives full trim.   -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Surface trimming warnings as errors so a regression in the generator (e.g. emitting    -->
    <!-- code that hits reflection on an annotated type) shows up in CI rather than silently.  -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The probe publishes self-contained, so the runtime pack it trims against is whichever one the installed SDK picks,
       and an SDK update can move it with nothing here changing. If the trimmer fails on a type the runtime always has
       (the .NET 8.0.30 pack died with IL1007 "Missing predefined 'System.NotSupportedException' type"), read
       includedFrameworks in the generated runtimeconfig.json before anything else. -->

  <ItemGroup>
    <ProjectReference Include="..\..\libs\AJut.Core\AJut.Core.csproj" />
    <ProjectReference Include="..\..\libs\AJut.Core.SourceGenerators\AJut.Core.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
