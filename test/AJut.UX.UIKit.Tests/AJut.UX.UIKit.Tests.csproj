<Project Sdk="Microsoft.NET.Sdk">
  <!-- UIKit views only run on an iPhone, an iPad, or the iOS simulator, so these tests are an app, as the Android ones
       are: it runs every [TestMethod] on the main thread at launch, prints each result, writes them to a file in its
       container, and quits. run-uikit-tests.sh builds it on a Mac, runs it in a simulator in light and in dark, and reads
       the results back. On Windows it compiles, and that is all. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RootNamespace>AJut.UX.Tests</RootNamespace>
    <ApplicationId>dev.ajut.ux.uikit.tests</ApplicationId>
    <ApplicationTitle>AJut UIKit Tests</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\AJut.UX.UIKit\AJut.UX.UIKit.csproj" />
  </ItemGroup>
</Project>
