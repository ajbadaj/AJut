# ============[ Begin Blacklist ]=========================
*

# ============[ Whitelist ]=========================
!**/
!LICENSE
!*.license.txt
!*.gitignore
!*.csproj
!*.sln
!*.slnx
!*.slnf
!*.cs
!*.xaml
!*.jpg
!*.png
!*.gif
!*.ico
!*.editorconfig
!.mailmap
!*.svg
!*.md
!**/_TestData
!*.snippet
!*.docklayout
!*.yml
!app.manifest
!*.appxmanifest
!launchSettings.json
!ProjectOrder.json
!*.pubxml
!*.ps1
!*.targets

# Bench sample payloads (deterministic, committed for inspection)
!test/AJut.Bench/Payloads/*.json

# Docking layout files saved by the showrooms, kept as test fixtures
!test/AJut.UX.Tests/_TestData/*.layout

# Apple app heads: bundle info and signing entitlements
!sandbox/appkit/Info.plist
!sandbox/appkit/Entitlements.plist
!sandbox/appkit/Assets.xcassets/**/Contents.json
!sandbox/uikit/Info.plist
!sandbox/uikit/Entitlements.plist
!sandbox/uikit/Assets.xcassets/**/Contents.json

# Android: manifests and Resources XML (layouts, values, drawables, styleable attrs)
!libs/AJut.UX.Android/**/*.xml
!sandbox/android/**/*.xml
!test/AJut.UX.Android.Tests/**/*.xml

# ============[ And finally nix these ]=========================
*Settings.Designer.cs
**/_ignore
**/obj
**/Debug
**/Release
**/BenchmarkDotNet.Artifacts